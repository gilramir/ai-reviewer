module Test.Marks exposing (suites)

{-| Where a commented passage is on the page, and how a run of text is split
around it.

The fixture below is what `Doc.text` produces for a page like the ones under
review: markup gone, a soft wrap standing as a single space, and — this is the
part that catches people — no separator at all between one block and the next.

-}

import Expect
import Marks
import Task
import Test.Runner.UnitNode as U


{-| A document as the client sees it: rendered text, no Markdown.

Written as one string per block so the shape of the source it came from stays
readable, and concatenated with nothing between the blocks because that is what
`Doc.text` does.

-}
document : String
document =
    -- # gren-tvision documentation
    "gren-tvision documentation"
        -- A paragraph. Note "Turbo Vision" occurs here first, so any test that
        -- expects to find a later occurrence is also testing that a near miss
        -- does not win.
        ++ "Turbo Vision terminal UIs, as the Elm architecture. Four documents, and they answer different questions."
        -- A bullet whose first phrase is a link inside bold: three elements,
        -- one phrase, and the reader sees none of the markup.
        ++ "Turbo Vision, from Gren -- what you are programming against."
        -- A bullet whose prose wraps, and which holds a code span. The wrap is
        -- the space before "Gren program"; the code span is CLIPBOARD.
        ++ "Driving a C or C++ library from Gren -- the general problem, of which this binding is one instance. The three doors out of a Gren program and which one is yours, and never the CLIPBOARD selection."


plain : Array Char
plain =
    Marks.plainText document


{-| The text a range covers, which is what the reader sees highlighted.
-}
covers : Maybe { start : Int, end : Int } -> Maybe String
covers found =
    Maybe.map (\range -> String.slice range.start range.end document) found


expect : Expect.Expectation -> Task.Task String Expect.Expectation
expect =
    Task.succeed


{-| A passage with no context recorded either side of it, which is every case
where only one occurrence is in question.
-}
bare : String -> Marks.Needle
bare quote =
    { quote = quote, prefix = "", suffix = "" }


suites : Array U.Suite
suites =
    [ findingAPassage
    , passagesThatAreNotThere
    , choosingBetweenOccurrences
    , splittingARun
    , twoHighlightsAtOnce
    , overlappingComments
    ]


{-| A browser hands over the text of a selection. The document is the rendered
tree's text. The two agree on words and disagree on whitespace, which is the
whole difficulty.
-}
findingAPassage : U.Suite
findingAPassage =
    U.suite
        { name = "Marks.find"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ U.test "a quote whose wrap is a newline matches text whose wrap is a space" <| \_ ->
                -- The reported bug: selecting across a wrapped line inside a
                -- bullet gave a quote with a bare "\n" in it.
                expect
                    (Expect.equal
                        (Just "The three doors out of a Gren program and which one is yours,")
                        (covers (Marks.find plain (bare "The three doors out of a\nGren program and which one is yours,")))
                    )
            , U.test "a quote inside link and bold markup is found" <| \_ ->
                expect
                    (Expect.equal
                        (Just "Turbo Vision, from Gren")
                        (covers (Marks.find plain (bare "Turbo Vision, from Gren")))
                    )
            , U.test "a quote across a code span is found" <| \_ ->
                -- The reader selects CLIPBOARD without its backticks, which
                -- is what the rendered text has too.
                expect
                    (Expect.equal
                        (Just "never the CLIPBOARD selection")
                        (covers (Marks.find plain (bare "never the CLIPBOARD selection")))
                    )
            , U.test "a near miss does not win over the real occurrence" <| \_ ->
                -- "Turbo Vision" appears three sentences earlier; the match
                -- has to run past it rather than stop on the prefix.
                expect
                    (Expect.equal
                        (Just 130)
                        (Maybe.map .start (Marks.find plain (bare "Turbo Vision, from Gren")))
                    )
            , U.test "the range ends where the passage ends" <| \_ ->
                expect
                    (Expect.equal
                        (Just 153)
                        (Maybe.map .end (Marks.find plain (bare "Turbo Vision, from Gren")))
                    )
            , U.test "leading and trailing whitespace in a quote is ignored" <| \_ ->
                expect
                    (Expect.equal
                        (Just "Turbo Vision, from Gren")
                        (covers (Marks.find plain (bare "\n  Turbo Vision, from Gren \n")))
                    )
            , U.test "a run of whitespace matches a run of any other whitespace" <| \_ ->
                expect
                    (Expect.equal
                        (Just "one two")
                        (Maybe.map (\r -> String.slice r.start r.end "one two three")
                            (Marks.find (Marks.plainText "one two three") (bare "one \n\t two"))
                        )
                    )
            ]
        }


passagesThatAreNotThere : U.Suite
passagesThatAreNotThere =
    U.suite
        { name = "Marks.find, when there is nothing to find"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ U.test "a passage that was edited away" <| \_ ->
                expect (Expect.equal Nothing (Marks.find plain (bare "a sentence that is no longer in the document")))
            , U.test "a blank quote is not a passage" <| \_ ->
                expect (Expect.equal Nothing (Marks.find plain (bare "   ")))
            , U.test "an empty quote is not a passage" <| \_ ->
                expect (Expect.equal Nothing (Marks.find plain (bare "")))
            , U.test "folding never invents whitespace that the document lacks" <| \_ ->
                -- The document runs the heading straight into the paragraph.
                expect (Expect.equal Nothing (Marks.find plain (bare "documentation Turbo Vision terminal")))
            , U.test "folding never joins two words" <| \_ ->
                expect (Expect.equal Nothing (Marks.find (Marks.plainText "one two three") (bare "onetwo")))
            , U.test "a selection spanning two blocks is not marked" <| \_ ->
                -- A known limit, written down rather than left to be
                -- rediscovered. Blocks are concatenated with nothing between
                -- them, so a selection across two of them carries a line
                -- break the document text has no room for. The comment still
                -- files -- the server searches the source, where the break is
                -- real -- but the passage is not highlighted on the page.
                expect (Expect.equal Nothing (Marks.find plain (bare "documentation\nTurbo Vision terminal")))
            ]
        }


{-| A phrase that occurs twice is two candidates, and the context recorded
either side of the passage is what decides between them.

This is the half of anchoring the client used to skip, taking the first match
and ignoring the prefix and suffix it was handed. A reviewer's own selection
hides the omission, because a selection long enough to be worth commenting on is
almost always unique. A comment raised by a reviewing pass quotes the words it is
about, and those repeat.

-}
choosingBetweenOccurrences : U.Suite
choosingBetweenOccurrences =
    let
        twice : Array Char
        twice =
            Marks.plainText "One: the daemon waits. Two: the daemon waits."
    in
    U.suite
        { name = "Marks.find, when the passage occurs more than once"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ U.test "the prefix picks the later occurrence" <| \_ ->
                expect
                    (Expect.equal
                        (Just 28)
                        (Maybe.map .start
                            (Marks.find twice
                                { quote = "the daemon waits."
                                , prefix = "Two: "
                                , suffix = ""
                                }
                            )
                        )
                    )
            , U.test "the prefix picks the earlier occurrence" <| \_ ->
                expect
                    (Expect.equal
                        (Just 5)
                        (Maybe.map .start
                            (Marks.find twice
                                { quote = "the daemon waits."
                                , prefix = "One: "
                                , suffix = ""
                                }
                            )
                        )
                    )
            , U.test "the suffix decides when the prefix cannot" <| \_ ->
                -- Both occurrences have "the " in front of them, so only what
                -- follows can tell them apart. The later one is chosen, which
                -- is the answer taking the first would never give.
                expect
                    (Expect.equal
                        (Just 27)
                        (Maybe.map .start
                            (Marks.find (Marks.plainText "the daemon waits. Then the daemon waits. End.")
                                { quote = "daemon waits."
                                , prefix = ""
                                , suffix = " End."
                                }
                            )
                        )
                    )
            , U.test "with no context recorded, the first occurrence still wins" <| \_ ->
                expect
                    (Expect.equal
                        (Just 5)
                        (Maybe.map .start (Marks.find twice (bare "the daemon waits.")))
                    )
            , U.test "context that matches nothing does not lose the passage" <| \_ ->
                expect
                    (Expect.equal
                        (Just 5)
                        (Maybe.map .start
                            (Marks.find twice
                                { quote = "the daemon waits."
                                , prefix = "nothing like this"
                                , suffix = "nor this"
                                }
                            )
                        )
                    )
            ]
        }


{-| A range is in document coordinates and a run of text knows only where it
starts, so every case here is about clipping one to the other. That clipping is
what lets one passage cross from one element into the next.

The second array is the passages that changed since the session started. It is
empty in most of these: the clipping is the same whichever kind of highlight is
being clipped, and the cases where the two meet are gathered at the end.

-}
splittingARun : U.Suite
splittingARun =
    U.suite
        { name = "Marks.split"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ U.test "a range wholly inside the run" <| \_ ->
                expect
                    (Expect.equal
                        [ { text = "ab", thread = Nothing, changed = False }
                        , { text = "cde", thread = Just "t1", changed = False }
                        , { text = "fg", thread = Nothing, changed = False }
                        ]
                        (Marks.split [ { start = 2, end = 5, thread = "t1" } ] [] 0 "abcdefg")
                    )
            , U.test "a range that began in an earlier run" <| \_ ->
                expect
                    (Expect.equal
                        [ { text = "ab", thread = Just "t1", changed = False }, { text = "cdefg", thread = Nothing, changed = False } ]
                        (Marks.split [ { start = 0, end = 12, thread = "t1" } ] [] 10 "abcdefg")
                    )
            , U.test "a range that continues into a later run" <| \_ ->
                expect
                    (Expect.equal
                        [ { text = "ab", thread = Nothing, changed = False }, { text = "cdefg", thread = Just "t1", changed = False } ]
                        (Marks.split [ { start = 12, end = 40, thread = "t1" } ] [] 10 "abcdefg")
                    )
            , U.test "a range that swallows the run whole" <| \_ ->
                expect
                    (Expect.equal
                        [ { text = "abcdefg", thread = Just "t1", changed = False } ]
                        (Marks.split [ { start = 0, end = 100, thread = "t1" } ] [] 10 "abcdefg")
                    )
            , U.test "a run no range touches" <| \_ ->
                expect
                    (Expect.equal
                        [ { text = "abcdefg", thread = Nothing, changed = False } ]
                        (Marks.split [ { start = 50, end = 60, thread = "t1" } ] [] 10 "abcdefg")
                    )
            , U.test "two ranges in one run" <| \_ ->
                expect
                    (Expect.equal
                        [ { text = "a", thread = Nothing, changed = False }
                        , { text = "b", thread = Just "t1", changed = False }
                        , { text = "cd", thread = Nothing, changed = False }
                        , { text = "ef", thread = Just "t2", changed = False }
                        , { text = "g", thread = Nothing, changed = False }
                        ]
                        (Marks.split [ { start = 1, end = 2, thread = "t1" }, { start = 4, end = 6, thread = "t2" } ] [] 0 "abcdefg")
                    )
            , U.test "a range that ends exactly where the run begins touches nothing" <| \_ ->
                expect
                    (Expect.equal
                        [ { text = "abcdefg", thread = Nothing, changed = False } ]
                        (Marks.split [ { start = 5, end = 10, thread = "t1" } ] [] 10 "abcdefg")
                    )
            , U.test "an empty run yields no pieces" <| \_ ->
                expect (Expect.equal [] (Marks.split [ { start = 0, end = 5, thread = "t1" } ] [] 0 ""))
            , U.test "no ranges at all leaves the run whole" <| \_ ->
                expect
                    (Expect.equal
                        [ { text = "abcdefg", thread = Nothing, changed = False } ]
                        (Marks.split [] [] 10 "abcdefg")
                    )
            , U.test "the pieces of a run always rebuild it" <| \_ ->
                expect
                    (Expect.equal "abcdefg"
                        (Array.foldl (\piece acc -> acc ++ piece.text)
                            ""
                            (Marks.split [ { start = 11, end = 14, thread = "t1" } ] [] 10 "abcdefg")
                        )
                    )
            ]
        }


{-| Two comments can be about passages that overlap: one on a sentence and one
on a clause inside it. A character belongs to both and only one of them can
colour it.
-}
overlappingComments : U.Suite
overlappingComments =
    U.suite
        { name = "Marks.split, overlapping comments"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ U.test "the narrower comment keeps its own words" <| \_ ->
                -- The inner comment is the more specific thing to have said,
                -- so it wins the characters it covers and the outer one keeps
                -- the rest. Taking the first would have lost the inner one
                -- entirely.
                expect
                    (Expect.equal
                        [ { text = "ab", thread = Just "outer", changed = False }
                        , { text = "cd", thread = Just "inner", changed = False }
                        , { text = "ef", thread = Just "outer", changed = False }
                        , { text = "g", thread = Nothing, changed = False }
                        ]
                        (Marks.split
                            [ { start = 0, end = 6, thread = "outer" }
                            , { start = 2, end = 4, thread = "inner" }
                            ]
                            []
                            0
                            "abcdefg"
                        )
                    )
            , U.test "a later comment does not hide an earlier one of the same width" <| \_ ->
                expect
                    (Expect.equal
                        [ { text = "ab", thread = Just "first", changed = False }
                        , { text = "cdefg", thread = Nothing, changed = False }
                        ]
                        (Marks.split
                            [ { start = 0, end = 2, thread = "first" }
                            , { start = 0, end = 2, thread = "second" }
                            ]
                            []
                            0
                            "abcdefg"
                        )
                    )
            ]
        }


{-| A comment is about a passage and a change is about a passage, and nothing
stops them being the same passage, or two that overlap. Every piece answers both
questions, so the page can show a sentence that was commented on, changed, both
or neither.
-}
twoHighlightsAtOnce : U.Suite
twoHighlightsAtOnce =
    U.suite
        { name = "Marks.split, comments and changes together"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ U.test "a change with no comment on it" <| \_ ->
                expect
                    (Expect.equal
                        [ { text = "ab", thread = Nothing, changed = False }
                        , { text = "cde", thread = Nothing, changed = True }
                        , { text = "fg", thread = Nothing, changed = False }
                        ]
                        (Marks.split [] [ { start = 2, end = 5 } ] 0 "abcdefg")
                    )
            , U.test "a passage that was both commented on and changed" <| \_ ->
                expect
                    (Expect.equal
                        [ { text = "ab", thread = Nothing, changed = False }
                        , { text = "cde", thread = Just "t1", changed = True }
                        , { text = "fg", thread = Nothing, changed = False }
                        ]
                        (Marks.split
                            [ { start = 2, end = 5, thread = "t1" } ]
                            [ { start = 2, end = 5 } ]
                            0
                            "abcdefg"
                        )
                    )
            , U.test "a change that overlaps the end of a comment" <| \_ ->
                -- Four pieces out of two passages: the comment alone, the two
                -- of them together, the change alone, and what neither covers.
                expect
                    (Expect.equal
                        [ { text = "a", thread = Nothing, changed = False }
                        , { text = "b", thread = Just "t1", changed = False }
                        , { text = "cd", thread = Just "t1", changed = True }
                        , { text = "ef", thread = Nothing, changed = True }
                        , { text = "g", thread = Nothing, changed = False }
                        ]
                        (Marks.split
                            [ { start = 1, end = 4, thread = "t1" } ]
                            [ { start = 2, end = 6 } ]
                            0
                            "abcdefg"
                        )
                    )
            , U.test "a change that began in an earlier run" <| \_ ->
                expect
                    (Expect.equal
                        [ { text = "ab", thread = Nothing, changed = True }
                        , { text = "cdefg", thread = Nothing, changed = False }
                        ]
                        (Marks.split [] [ { start = 4, end = 12 } ] 10 "abcdefg")
                    )
            , U.test "the pieces of a run always rebuild it" <| \_ ->
                expect
                    (Expect.equal "abcdefg"
                        (Array.foldl (\piece acc -> acc ++ piece.text)
                            ""
                            (Marks.split
                                [ { start = 11, end = 14, thread = "t1" } ]
                                [ { start = 12, end = 13 }, { start = 15, end = 20 } ]
                                10
                                "abcdefg"
                            )
                        )
                    )
            ]
        }
