module Protocol exposing
    ( Anchor
    , Conversation
    , Landing
    , Message
    , Origin(..)
    , Pass
    , Role(..)
    , ServerMsg(..)
    , Settings
    , Thread
    , ThreadStatus(..)
    , applyEdit
    , clearContext
    , comment
    , editSource
    , interrupt
    , openDoc
    , reply
    , resolve
    , review
    , serverMsgDecoder
    , setModel
    )

{-| The wire protocol between the browser and the review daemon.

Both directions are newline-free JSON objects tagged with a `type` field, sent
over one WebSocket per browser tab. The server is authoritative for everything
persistent: the client holds no state it could not rebuild from a fresh
`doc` + `threads` pair.

-}

import Array exposing (Array)
import Doc exposing (Doc)
import Json.Decode as Decode exposing (Decoder)
import Json.Encode as Encode
import Marks exposing (Change)


-- ANCHORS


{-| Where a comment is attached.

`quote` is the text the reviewer actually selected; `prefix` and `suffix` are
the surrounding characters. The server re-locates a thread after every edit by
searching for this triple, which is why the anchor is text rather than byte
offsets: an edit earlier in the file shifts every offset but leaves the
surrounding words alone.

`nodeId` is only a hint for the first lookup and for rendering the highlight —
it is not trusted after the document changes.

-}
type alias Anchor =
    { nodeId : String
    , quote : String
    , prefix : String
    , suffix : String
    }


-- THREADS


type alias Thread =
    { id : String
    , doc : String
    , anchor : Anchor
    , status : ThreadStatus
    , messages : Array Message
    , commit : String
    , origin : Origin
    , brief : String
    }


{-| Who opened a thread.

A field rather than a reading of who wrote the first message: the two answers
diverge the moment anything is appended, and the sidebar asks this question of
threads that are several turns old.

-}
type Origin
    = Reviewer
    | Model


{-| Where a thread sits in its lifecycle.

Four, and a machine review adds none. A comment raised by a pass is `Open` like
any other -- open means somebody owes something, and which somebody is a reading
of who spoke last rather than a fifth state to teach this decoder, `reanchor`
and every view that switches on one.

-}
type ThreadStatus
    = Open
    | Thinking
    | Resolved
    | Outdated


type alias Message =
    { role : Role
    , text : String
    }


type Role
    = User
    | Assistant


-- SERVER -> CLIENT


{-| One document's conversation, as it stands: how many turns it holds and what
they cost. Both go back to nothing when the context is cleared.
-}
type alias Conversation =
    { doc : String
    , turns : Int
    , spentUsd : Float
    }


{-| The commands a finished review ends in, as the daemon spells them out.

Two paths of two, because "merge it" is two different decisions -- keep the
turn-by-turn commits or fold them into one -- and each leaves the branch behind
in a different state. The deletes are not interchangeable: `-d` refuses after a
squash, so each merge carries the delete that works after it. All four are
empty when there is nothing to land.

-}
type alias Landing =
    { merge : String
    , delete : String
    , squash : String
    , squashDelete : String
    }


{-| What the daemon is running Claude with.

Two models, not one: `model` is what the daemon asks for and may be empty --
meaning it asks for nothing and the CLI uses the reviewer's own default --
while `runningModel` is what the CLI reported resolving that to. The second is
the one that answers "am I on Opus or Sonnet right now?".

-}
type alias Settings =
    { model : String
    , runningModel : String
    , modelChoices : Array String
    , tools : Array String
    , permissionMode : String
    , workspace : String
    , reviewRoot : String
    , branch : String
    , baseBranch : String
    , commits : Int
    , landing : Landing
    , maxBudgetUsd : Float
    , spentUsd : Float
    , live : Int
    , cliPath : String
    , cliVersion : String
    , conversations : Array Conversation
    , criticTools : Array String
    , brief : String
    }


{-| How far a reviewing pass has got through a document.

`active` going false is the pass being over, and takes the notice off the
screen. It is separate from `busy` because "thinking" and "on section 3 of 9"
are different things to be told: one is a spinner, the other is a reason to
wait.

-}
type alias Pass =
    { doc : String
    , active : Bool
    , section : Int
    , total : Int
    , title : String
    , brief : String
    }


type ServerMsg
    = DocUpdated { doc : Doc, changes : Array Change }
    | ThreadsUpdated { doc : String, threads : Array Thread }
    | AssistantDelta { threadId : String, text : String }
    | TurnEnded { threadId : String, edited : Bool, commit : String }
    | BusyChanged { doc : String, busy : Bool }
    | PassProgress Pass
    | DocList (Array String)
    | SettingsUpdated Settings
    | EditSource { doc : String, quote : String, text : String }
    | EditApplied { doc : String, quote : String, commit : String }
    | ServerError String


serverMsgDecoder : Decoder ServerMsg
serverMsgDecoder =
    Decode.field "type" Decode.string
        |> Decode.andThen serverMsgBody


serverMsgBody : String -> Decoder ServerMsg
serverMsgBody tag =
    when tag is
        "doc" ->
            Decode.map2
                (\doc changes -> DocUpdated { doc = doc, changes = changes })
                (Decode.field "doc" Doc.decoder)
                changesDecoder

        "threads" ->
            Decode.map2
                (\doc threads -> ThreadsUpdated { doc = doc, threads = threads })
                (Decode.field "doc" Decode.string)
                (Decode.field "threads" (Decode.array threadDecoder))

        "assistant" ->
            Decode.map2
                (\threadId text -> AssistantDelta { threadId = threadId, text = text })
                (Decode.field "threadId" Decode.string)
                (Decode.field "text" Decode.string)

        "turnEnd" ->
            Decode.map3
                (\threadId edited commit ->
                    TurnEnded { threadId = threadId, edited = edited, commit = commit }
                )
                (Decode.field "threadId" Decode.string)
                (Decode.field "edited" Decode.bool)
                (Decode.oneOf [ Decode.field "commit" Decode.string, Decode.succeed "" ])

        "busy" ->
            Decode.map2
                (\doc busy -> BusyChanged { doc = doc, busy = busy })
                (Decode.field "doc" Decode.string)
                (Decode.field "busy" Decode.bool)

        "pass" ->
            Decode.map PassProgress passDecoder

        "docList" ->
            Decode.map DocList (Decode.field "docs" (Decode.array Decode.string))

        "settings" ->
            Decode.map SettingsUpdated (Decode.field "settings" settingsDecoder)

        "editSource" ->
            Decode.map3
                (\doc quote text -> EditSource { doc = doc, quote = quote, text = text })
                (Decode.field "doc" Decode.string)
                (Decode.field "quote" Decode.string)
                (Decode.field "text" Decode.string)

        "editApplied" ->
            Decode.map3
                (\doc quote commit -> EditApplied { doc = doc, quote = quote, commit = commit })
                (Decode.field "doc" Decode.string)
                (Decode.field "quote" Decode.string)
                (Decode.oneOf [ Decode.field "commit" Decode.string, Decode.succeed "" ])

        "error" ->
            Decode.map ServerError (Decode.field "message" Decode.string)

        _ ->
            Decode.fail ("unknown server message type: " ++ tag)


passDecoder : Decoder Pass
passDecoder =
    Decode.map6
        (\doc active section total title brief ->
            { doc = doc
            , active = active
            , section = section
            , total = total
            , title = title
            , brief = brief
            }
        )
        (Decode.field "doc" Decode.string)
        (Decode.oneOf [ Decode.field "active" Decode.bool, Decode.succeed False ])
        (optionalInt "section")
        (optionalInt "total")
        (optionalString "title")
        (optionalString "brief")


{-| The passages of this render that the session did not start with. Absent
when there are none, which is every render of a document nobody has touched.
-}
changesDecoder : Decoder (Array Change)
changesDecoder =
    Decode.oneOf
        [ Decode.field "changes" (Decode.array changeDecoder)
        , Decode.succeed []
        ]


changeDecoder : Decoder Change
changeDecoder =
    Decode.map2
        (\start end -> { start = start, end = end })
        (Decode.field "start" Decode.int)
        (Decode.field "end" Decode.int)


{-| The Go side omits zero values, so every field here has a default rather than
a failed decode -- an empty model and a zero spend are both ordinary states.
-}
settingsDecoder : Decoder Settings
settingsDecoder =
    Decode.map5
        (\models paths branch spend conversations ->
            { model = models.model
            , runningModel = models.running
            , modelChoices = models.choices
            , tools = paths.tools
            , permissionMode = paths.permissionMode
            , workspace = paths.workspace
            , reviewRoot = paths.reviewRoot
            , branch = branch.branch
            , baseBranch = branch.baseBranch
            , commits = branch.commits
            , landing = branch.landing
            , maxBudgetUsd = spend.maxBudgetUsd
            , spentUsd = spend.spentUsd
            , live = spend.live
            , cliPath = spend.cliPath
            , cliVersion = spend.cliVersion
            , conversations = conversations.conversations
            , criticTools = conversations.criticTools
            , brief = conversations.brief
            }
        )
        modelsDecoder
        toolsDecoder
        branchDecoder
        spendDecoder
        conversationsDecoder


modelsDecoder : Decoder { model : String, running : String, choices : Array String }
modelsDecoder =
    Decode.map3
        (\model running choices -> { model = model, running = running, choices = choices })
        (optionalString "model")
        (optionalString "runningModel")
        (optionalStrings "modelChoices")


toolsDecoder :
    Decoder
        { tools : Array String
        , permissionMode : String
        , workspace : String
        , reviewRoot : String
        }
toolsDecoder =
    Decode.map4
        (\tools mode workspace reviewRoot ->
            { tools = tools
            , permissionMode = mode
            , workspace = workspace
            , reviewRoot = reviewRoot
            }
        )
        (optionalStrings "tools")
        (optionalString "permissionMode")
        (optionalString "workspace")
        (optionalString "reviewRoot")


{-| Where the review's commits are, and what to do with them.
-}
branchDecoder :
    Decoder
        { branch : String
        , baseBranch : String
        , commits : Int
        , landing : Landing
        }
branchDecoder =
    Decode.map4
        (\branch base commits land ->
            { branch = branch
            , baseBranch = base
            , commits = commits
            , landing = land
            }
        )
        (optionalString "branch")
        (optionalString "baseBranch")
        (optionalInt "commits")
        landingDecoder


landingDecoder : Decoder Landing
landingDecoder =
    Decode.oneOf
        [ Decode.field "landing"
            (Decode.map4
                (\merge remove squash removeHard ->
                    { merge = merge
                    , delete = remove
                    , squash = squash
                    , squashDelete = removeHard
                    }
                )
                (optionalString "merge")
                (optionalString "delete")
                (optionalString "squash")
                (optionalString "squashDelete")
            )
        , Decode.succeed
            { merge = "", delete = "", squash = "", squashDelete = "" }
        ]


spendDecoder :
    Decoder
        { maxBudgetUsd : Float
        , spentUsd : Float
        , live : Int
        , cliPath : String
        , cliVersion : String
        }
spendDecoder =
    Decode.map5
        (\budget spent live path version ->
            { maxBudgetUsd = budget
            , spentUsd = spent
            , live = live
            , cliPath = path
            , cliVersion = version
            }
        )
        (optionalFloat "maxBudgetUsd")
        (optionalFloat "spentUsd")
        (optionalInt "live")
        (optionalString "cliPath")
        (optionalString "cliVersion")


optionalString : String -> Decoder String
optionalString field =
    Decode.oneOf [ Decode.field field Decode.string, Decode.succeed "" ]


optionalStrings : String -> Decoder (Array String)
optionalStrings field =
    Decode.oneOf [ Decode.field field (Decode.array Decode.string), Decode.succeed [] ]


optionalFloat : String -> Decoder Float
optionalFloat field =
    Decode.oneOf [ Decode.field field Decode.float, Decode.succeed 0 ]


optionalInt : String -> Decoder Int
optionalInt field =
    Decode.oneOf [ Decode.field field Decode.int, Decode.succeed 0 ]


{-| The conversations, and what a reviewing pass runs with: the brief it takes
when nobody says, and the tools it is allowed -- which is the shorter list, and
is shown because "it cannot edit the document" is the claim the whole feature
rests on.
-}
conversationsDecoder :
    Decoder
        { conversations : Array Conversation
        , criticTools : Array String
        , brief : String
        }
conversationsDecoder =
    Decode.map3
        (\conversations tools brief ->
            { conversations = conversations, criticTools = tools, brief = brief }
        )
        (Decode.oneOf
            [ Decode.field "conversations" (Decode.array conversationDecoder)
            , Decode.succeed []
            ]
        )
        (optionalStrings "criticTools")
        (optionalString "brief")


conversationDecoder : Decoder Conversation
conversationDecoder =
    Decode.map3
        (\doc turns spent -> { doc = doc, turns = turns, spentUsd = spent })
        (Decode.field "doc" Decode.string)
        (optionalInt "turns")
        (optionalFloat "spentUsd")


threadDecoder : Decoder Thread
threadDecoder =
    Decode.map7
        (\threadId doc anchor status messages commit raised ->
            { id = threadId
            , doc = doc
            , anchor = anchor
            , status = status
            , messages = messages
            , commit = commit
            , origin = raised.origin
            , brief = raised.brief
            }
        )
        (Decode.field "id" Decode.string)
        (Decode.field "doc" Decode.string)
        (Decode.field "anchor" anchorDecoder)
        (Decode.field "status" (Decode.map statusFromTag Decode.string))
        (Decode.field "messages" (Decode.array messageDecoder))
        (Decode.oneOf [ Decode.field "commit" Decode.string, Decode.succeed "" ])
        raisedDecoder


{-| Who raised the thread and what they were looking for. Both absent on a
thread filed before machine review existed, which makes it a reviewer's.
-}
raisedDecoder : Decoder { origin : Origin, brief : String }
raisedDecoder =
    Decode.map2
        (\origin brief -> { origin = origin, brief = brief })
        (Decode.map originFromTag (optionalString "origin"))
        (optionalString "brief")


originFromTag : String -> Origin
originFromTag tag =
    when tag is
        "model" ->
            Model

        _ ->
            Reviewer


anchorDecoder : Decoder Anchor
anchorDecoder =
    Decode.map4
        (\nodeId quote prefix suffix ->
            { nodeId = nodeId, quote = quote, prefix = prefix, suffix = suffix }
        )
        (Decode.field "nodeId" Decode.string)
        (Decode.field "quote" Decode.string)
        (Decode.oneOf [ Decode.field "prefix" Decode.string, Decode.succeed "" ])
        (Decode.oneOf [ Decode.field "suffix" Decode.string, Decode.succeed "" ])


messageDecoder : Decoder Message
messageDecoder =
    Decode.map2
        (\role text -> { role = role, text = text })
        (Decode.field "role" (Decode.map roleFromTag Decode.string))
        (Decode.field "text" Decode.string)


statusFromTag : String -> ThreadStatus
statusFromTag tag =
    when tag is
        "thinking" ->
            Thinking

        "resolved" ->
            Resolved

        "outdated" ->
            Outdated

        _ ->
            Open


roleFromTag : String -> Role
roleFromTag tag =
    when tag is
        "assistant" ->
            Assistant

        _ ->
            User


-- CLIENT -> SERVER


openDoc : String -> Encode.Value
openDoc path =
    tagged "openDoc" [ { key = "path", value = Encode.string path } ]


comment : { doc : String, anchor : Anchor, body : String } -> Encode.Value
comment args =
    tagged "comment"
        [ { key = "doc", value = Encode.string args.doc }
        , { key = "anchor", value = encodeAnchor args.anchor }
        , { key = "body", value = Encode.string args.body }
        ]


{-| Ask for the Markdown behind a passage, so the reviewer can change it
themselves. The rendered text they selected is not it: the syntax was eaten on
the way to the screen.
-}
editSource : { doc : String, anchor : Anchor } -> Encode.Value
editSource args =
    tagged "editSource"
        [ { key = "doc", value = Encode.string args.doc }
        , { key = "anchor", value = encodeAnchor args.anchor }
        ]


{-| Put the reviewer's own words in place of a passage.

`original` is what the editor was opened on. The server writes the replacement
only if the passage still reads exactly that way, so an edit the model landed in
the meantime is refused rather than overwritten.

-}
applyEdit :
    { doc : String
    , anchor : Anchor
    , original : String
    , replacement : String
    }
    -> Encode.Value
applyEdit args =
    tagged "applyEdit"
        [ { key = "doc", value = Encode.string args.doc }
        , { key = "anchor", value = encodeAnchor args.anchor }
        , { key = "original", value = Encode.string args.original }
        , { key = "replacement", value = Encode.string args.replacement }
        ]


reply : { threadId : String, body : String } -> Encode.Value
reply args =
    tagged "reply"
        [ { key = "threadId", value = Encode.string args.threadId }
        , { key = "body", value = Encode.string args.body }
        ]


resolve : String -> Encode.Value
resolve threadId =
    tagged "resolve" [ { key = "threadId", value = Encode.string threadId } ]


interrupt : String -> Encode.Value
interrupt doc =
    tagged "interrupt" [ { key = "doc", value = Encode.string doc } ]


{-| Ask for the document to be read and commented on.

An empty brief takes the standing one from `.ai-reviewer/review.md`, which is
the usual case: the brief is a setting rather than something typed each time.

-}
review : { doc : String, brief : String } -> Encode.Value
review args =
    tagged "review"
        [ { key = "doc", value = Encode.string args.doc }
        , { key = "brief", value = Encode.string args.brief }
        ]


{-| Throw away what the model remembers, on every document. The threads are the
daemon's, and they stay.
-}
clearContext : Encode.Value
clearContext =
    tagged "clearContext" []


{-| Ask for a different model. An empty string means "whatever the reviewer's
own claude configuration selects", which is the daemon's default.
-}
setModel : String -> Encode.Value
setModel model =
    tagged "setModel" [ { key = "model", value = Encode.string model } ]


encodeAnchor : Anchor -> Encode.Value
encodeAnchor anchor =
    Encode.object
        [ { key = "nodeId", value = Encode.string anchor.nodeId }
        , { key = "quote", value = Encode.string anchor.quote }
        , { key = "prefix", value = Encode.string anchor.prefix }
        , { key = "suffix", value = Encode.string anchor.suffix }
        ]


tagged : String -> Array { key : String, value : Encode.Value } -> Encode.Value
tagged tag fields =
    Encode.object
        (Array.pushFirst { key = "type", value = Encode.string tag } fields)
