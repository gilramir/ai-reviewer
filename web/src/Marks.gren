module Marks exposing
    ( Change
    , Needle
    , Piece
    , Range
    , find
    , plainText
    , split
    )

{-| Locating a commented passage in the text of a document, and splitting a
run of that text around the passages found in it.

This is the client's half of anchoring, and the server now does the same thing:
it flattens the tree it parsed back to the text the reader sees and searches
that. Matching a selection against the Markdown source was the older idea, and
it could not be made to work -- a link's destination is ordinary text that the
renderer ate, and no rule about skipping syntax characters gets past it. On both
sides, then, the only thing that differs between a quote and the document is how
whitespace fell.

A quote is located as a range over the whole document's text rather than inside
one node, because a passage does not respect the tree: `**[a link](x)**` puts
three elements inside one sentence, and a line that wraps puts a `<br>` in the
middle of one. Ranges are in code points, counted the way `Doc.text` produces
them.

-}

import Array exposing (Array)
import Array.Builder as Builder
import Char


{-| A passage to look for, and the characters recorded either side of it.

The context is not decoration. A phrase that occurs twice has two places it
could be, and the server chooses between them by how much of the surrounding
text each still has -- so if the client chooses by "the first one", the two
disagree and the highlight lands on a sentence the thread is not about. That
never showed while only a human filed comments, because a selection is long
enough to be unique; a comment raised by a reviewing pass quotes whatever it is
talking about, and "the reviewer" is not unique in a document about reviewing.

-}
type alias Needle =
    { quote : String
    , prefix : String
    , suffix : String
    }


{-| A commented passage on the page: a half-open range of the document's text,
and the thread anchored to it.

The thread travels with the range so that the highlight can be clicked: what the
reader points at is a passage, and what they mean by pointing at it is the
conversation about that passage.

-}
type alias Range =
    { start : Int
    , end : Int
    , thread : String
    }


{-| A passage that is not what it was when the session started.

It carries no thread, because a change is not a conversation -- nobody asked
about it and there is nothing to go to. It is only the page saying which of its
words are new to the reader.

-}
type alias Change =
    { start : Int
    , end : Int
    }


{-| A run of text, the thread whose passage covers it, and whether it is one of
the passages that changed.

The two are independent: a sentence can be commented on, changed, both, or
neither, and the reader has to be able to tell which.

-}
type alias Piece =
    { text : String
    , thread : Maybe String
    , changed : Bool
    }


{-| The document text as the characters `find` searches.

Not `String.toArray`, which is a fold over `Array.pushLast` -- and `pushLast`
copies the whole array to add one element to it. That is nothing for a quote and
quadratic for a document: a hundred thousand characters is five thousand million
copies, which measured at eight seconds of a browser doing nothing else and
three more collecting the arrays it threw away. A builder fills one array and
hands it over at the end.

-}
plainText : String -> Array Char
plainText text =
    String.foldl Builder.pushLast (Builder.empty (String.count text)) text
        |> Builder.toArray


{-| Where a passage sits in the document, or nothing when it is gone.

One place per needle: a comment is about one passage, so a phrase that repeats
is marked in one of the places it occurs and not in all of them. Which one is
decided by the context, on the same evidence and by the same arithmetic the
server uses -- the two halves have to agree, and agreeing by accident stopped
working the moment comments started quoting short phrases.

Which thread a passage belongs to is the caller's business, not this search's.

-}
find : Array Char -> Needle -> Maybe { start : Int, end : Int }
find document needle =
    let
        quote =
            String.toArray (String.trim needle.quote)
    in
    if Array.isEmpty quote then
        Nothing

    else
        Array.foldl (better document needle) Nothing (searchAll document quote 0 [])


{-| Every place the quote occurs. Overlapping matches of one passage are never
two answers, so the walk resumes past each hit rather than one character on.
-}
searchAll :
    Array Char
    -> Array Char
    -> Int
    -> Array { start : Int, end : Int }
    -> Array { start : Int, end : Int }
searchAll document needle at found =
    if at >= Array.length document then
        found

    else
        when matchAt document needle at 0 is
            Just end ->
                searchAll document needle end (Array.pushLast { start = at, end = end } found)

            Nothing ->
                searchAll document needle (at + 1) found


{-| Keep whichever candidate has more of the recorded context around it, and the
earlier one when they are level -- which is every case where the needle carries
no context at all.
-}
better :
    Array Char
    -> Needle
    -> { start : Int, end : Int }
    -> Maybe { start : Int, end : Int }
    -> Maybe { start : Int, end : Int }
better document needle candidate best =
    when best is
        Nothing ->
            Just candidate

        Just current ->
            if score document needle candidate > score document needle current then
                Just candidate

            else
                best


{-| How much of the recorded prefix and suffix a candidate still has around it.

Letters and digits only, lowercased, so a difference in how whitespace fell or
in what punctuation survived an edit does not count against a match. The window
is wider than the context it is compared with for that same reason: stripping
turns a long stretch of source into a short one.

-}
score : Array Char -> Needle -> { start : Int, end : Int } -> Int
score document needle at =
    let
        before =
            normalise (slice (at.start - window needle.prefix) at.start document)

        after =
            normalise (slice at.end (at.end + window needle.suffix) document)
    in
    commonSuffix before (normalise (String.toArray needle.prefix))
        + commonPrefix after (normalise (String.toArray needle.suffix))


window : String -> Int
window context =
    4 * String.count context + 16


slice : Int -> Int -> Array Char -> Array Char
slice from to chars =
    Array.slice (max 0 from) (min (Array.length chars) to) chars


normalise : Array Char -> Array Char
normalise chars =
    -- Case is folded through String because Gren's Char has no toLower: the
    -- answer depends on the locale rules a String carries and a code point on
    -- its own does not.
    chars
        |> String.fromArray
        |> String.toLower
        |> String.toArray
        |> Array.keepIf Char.isAlphaNum


commonPrefix : Array Char -> Array Char -> Int
commonPrefix a b =
    countMatching a b 0


commonSuffix : Array Char -> Array Char -> Int
commonSuffix a b =
    countMatching (Array.reverse a) (Array.reverse b) 0


countMatching : Array Char -> Array Char -> Int -> Int
countMatching a b n =
    when { left = Array.get n a, right = Array.get n b } is
        { left = Just x, right = Just y } ->
            if x == y then
                countMatching a b (n + 1)

            else
                n

        _ ->
            n


{-| Match the needle at one position, folding whitespace on both sides.

The quote came from a browser selection and the document text from the rendered
tree, and the two disagree about whitespace: a soft wrap reaches the selection
as a newline and the tree as a space. Runs of whitespace are therefore compared
as runs -- one run matches another whatever either is made of -- which is the
same rule the server applies to the source.

-}
matchAt : Array Char -> Array Char -> Int -> Int -> Maybe Int
matchAt document needle si qi =
    when Array.get qi needle is
        Nothing ->
            Just si

        Just nc ->
            when Array.get si document is
                Nothing ->
                    Nothing

                Just dc ->
                    if isSpace dc && isSpace nc then
                        matchAt document needle (skipSpace document si) (skipSpace needle qi)

                    else if dc == nc then
                        matchAt document needle (si + 1) (qi + 1)

                    else
                        Nothing


skipSpace : Array Char -> Int -> Int
skipSpace chars at =
    when Array.get at chars is
        Just c ->
            if isSpace c then
                skipSpace chars (at + 1)

            else
                at

        Nothing ->
            at


isSpace : Char -> Bool
isSpace c =
    c == ' ' || c == '\n' || c == '\t' || c == '\r'


{-| Split one run of text around the passages falling inside it.

`base` is where the run starts in the document text, which is what lets ranges
in document coordinates be applied to a single node's string. A range wider than
the run is clipped to it: the rest of it belongs to the nodes either side, and
they will clip their own share of it when the walk reaches them.

The split is driven by the edges rather than by the passages, because there are
two kinds of passage here and they overlap freely. Every place where either kind
starts or stops ends a piece, and each piece then asks both what covers it.

The ranges must be sorted by `start`.

-}
split : Array Range -> Array Change -> Int -> String -> Array Piece
split ranges changes base text =
    let
        stop =
            base + String.count text
    in
    if String.isEmpty text then
        []

    else
        edges ranges changes base stop
            |> Array.foldl
                (\edge acc ->
                    if edge <= acc.at then
                        -- Two passages ending in the same place, or one
                        -- starting where another stops: one edge, one piece.
                        acc

                    else
                        { at = edge
                        , pieces =
                            Array.pushLast
                                { text = cut base acc.at edge text
                                , thread = threadAt ranges acc.at
                                , changed = isChangedAt changes acc.at
                                }
                                acc.pieces
                        }
                )
                { at = base, pieces = [] }
            |> .pieces


{-| Where the pieces of one run divide: every point inside it at which a passage
of either kind begins or ends, and then its end.
-}
edges : Array Range -> Array Change -> Int -> Int -> Array Int
edges ranges changes base stop =
    Array.flatten
        [ Array.mapAndFlatten (\range -> [ range.start, range.end ]) ranges
        , Array.mapAndFlatten (\change -> [ change.start, change.end ]) changes
        ]
        |> Array.keepIf (\at -> at > base && at < stop)
        |> Array.sort
        |> Array.pushLast stop


{-| The thread whose passage covers a point, if one does.

The narrowest of them when several do. Passages overlap: a comment on a sentence
and a comment on a clause inside it are two threads, and one character belongs
to both. Only one of them can colour it, and the narrower one is the more
specific thing to have said -- so the inner comment wins its own words and the
outer one keeps the rest. The outer highlight is then drawn with a hole in it,
which is the honest picture and the reason this is not a sort.

Taking the first instead was survivable while only a reviewer filed comments,
because two selections rarely overlap. A pass over a section produces overlapping
quotes as a matter of course.

-}
threadAt : Array Range -> Int -> Maybe String
threadAt ranges at =
    ranges
        |> Array.keepIf (\range -> range.start <= at && at < range.end)
        |> Array.foldl narrower Nothing
        |> Maybe.map .thread


narrower : Range -> Maybe Range -> Maybe Range
narrower range best =
    when best is
        Nothing ->
            Just range

        Just current ->
            if range.end - range.start < current.end - current.start then
                Just range

            else
                best


isChangedAt : Array Change -> Int -> Bool
isChangedAt changes at =
    Array.any (\change -> change.start <= at && at < change.end) changes


{-| The slice of a run's text between two document offsets.
-}
cut : Int -> Int -> Int -> String -> String
cut base from to text =
    String.slice (from - base) (to - base) text
