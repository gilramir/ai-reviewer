port module Main exposing (main)

{-| The review UI.

The client renders a tree the server parsed and holds no Markdown of its own.
Everything durable — documents, threads, transcripts, commits — lives on the
server; a reload rebuilds this model from one `doc` and one `threads` message.

-}

import Array exposing (Array)
import Browser
import Browser.Dom as Dom
import Dict exposing (Dict)
import Doc exposing (Align(..), Doc, Kind(..), Node)
import Html exposing (Html)
import Html.Attributes as Attr
import Html.Events as Events
import Html.Keyed
import Html.Lazy
import Json.Decode as Decode
import Json.Encode as Encode
import Marks exposing (Change, Range)
import Math
import Picker
import Protocol exposing (Anchor, Origin(..), Role(..), ServerMsg(..), Thread, ThreadStatus(..))
import Svg
import Svg.Attributes as SvgAttr
import Task


-- PORTS
--
-- Four, and only four. Everything else the app needs is expressible in Gren.


{-| Outbound protocol frames. The JS side stringifies and writes to the socket.
-}
port socketOut : Encode.Value -> Cmd msg


{-| Inbound protocol frames, already parsed from JSON by the JS side.
-}
port socketIn : (Decode.Value -> msg) -> Sub msg


{-| Connection lifecycle: "open", "closed", or "connecting".
-}
port socketState : (String -> msg) -> Sub msg


{-| A completed text selection inside the document pane.

The JS side does the DOM work — walking up to the nearest `[data-node-id]`,
reading the surrounding characters for the anchor — and hands over a finished
anchor. Sending text rather than DOM offsets means the payload stays valid even
if a re-render lands while the reviewer is still typing their comment.

-}
port selectionIn : (Decode.Value -> msg) -> Sub msg


{-| Drop the browser selection once a comment has been filed.
-}
port clearSelection : {} -> Cmd msg


{-| The reviewer's choice of theme: "auto", "light" or "dark".

A Gren program owns the element it is mounted into and nothing above it, and the
whole switch is one `color-scheme` on `<html>`. The JS side also remembers the
choice, so the page it draws on the next visit is the one that was left.

-}
port setTheme : String -> Cmd msg


{-| Remember whether the change highlight is wanted.

It is a display preference like the theme, kept in this browser rather than in
the daemon: two people reading the same review can want different amounts of
colour on it, and the daemon has no business holding either answer.

-}
port rememberChanges : Bool -> Cmd msg


{-| Remember whether resolved threads are wanted in the column.

The same kind of preference, kept in the same place and for the same reason --
and worth remembering rather than asking again, because the answer is given
while a review is filling the column up and the reload that would forget it is
usually in the middle of one.

-}
port rememberResolved : Bool -> Cmd msg


-- MODEL


type alias Model =
    { theme : String
    , docs : Array String
    , opened : String
    , picking : Maybe Picking
    , current : Maybe Doc
    , threads : Array Thread
    , busy : Bool
    , composing : Maybe Composing
    , marks : Array Range
    , changes : Array Change
    , showChanges : Bool
    , showResolved : Bool
    , replyDrafts : Dict String String
    , connection : String
    , settings : Maybe Protocol.Settings
    , settingsOpen : Bool
    , pass : Maybe Protocol.Pass
    , briefing : Maybe String
    , error : Maybe String
    }


{-| The document picker, while it is open.

`query` is what has been typed to narrow the list; `cursor` is the row the
keyboard is on, as an index into the documents that query leaves. It is an index
rather than a path because the row a reviewer means by "the next one" is a
position in the list in front of them, and that list changes with every
keystroke.

-}
type alias Picking =
    { query : String
    , cursor : Int
    }


{-| A comment being written.

Typed words are the one thing in this app the server cannot give back, so the
composer is only ever closed by the reviewer or by the arrival of the filed
comment itself. Neither a re-render nor a rejected submission discards it.

`sent` holds the exact text handed to the server while it is unconfirmed, so the
thread list can be matched against it; `stale` records that the passage was
edited away underneath the draft.

-}
type alias Composing =
    { anchor : Anchor
    , draft : String
    , sent : Maybe String
    , stale : Bool
    , edit : Maybe Editing
    }


{-| A passage the reviewer is rewriting themselves.

Not every comment is a question. When the reviewer already has the words they
want, a turn spent having the model type them back is slower and paid for by the
token, so the passage is handed over as Markdown and written straight to the
file.

`source` is what the server found behind the selection — the browser renders a
tree it never sees the syntax of, so the words on screen are not what is in the
file. It is also the compare-and-swap: the server writes the replacement only
while the passage still reads exactly this way.

-}
type alias Editing =
    { source : String
    , draft : String
    , ready : Bool
    , sent : Bool
    }


{-| The theme comes in as a flag because the page has already been drawn in it:
the script in index.html applies the saved choice before the first paint, and
this is the app being told what that was rather than deciding it again. The
change highlight comes the same way, though only because the two are the same
kind of thing: nothing is drawn in it until a document arrives.
-}
init : { theme : String, showChanges : Bool, showResolved : Bool } -> { model : Model, command : Cmd Msg }
init flags =
    { model =
        { theme = flags.theme
        , docs = []
        , opened = ""
        , picking = Nothing
        , current = Nothing
        , threads = []
        , busy = False
        , composing = Nothing
        , marks = []
        , changes = []
        , showChanges = flags.showChanges
        , showResolved = flags.showResolved
        , replyDrafts = Dict.empty
        , connection = "connecting"
        , settings = Nothing
        , settingsOpen = False
        , pass = Nothing
        , briefing = Nothing
        , error = Nothing
        }
    , command = Cmd.none
    }


-- UPDATE


type Msg
    = ServerFrame Decode.Value
    | SelectionMade Decode.Value
    | ConnectionState String
    | OpenDoc String
    | TogglePicker
    | ClosePicker
    | PickerTyped String
    | PickerMoved Int
    | PickerChose
    | PickerSettled
    | DraftChanged String
    | SubmitComment
    | CancelComment
    | StartEdit
    | EditChanged String
    | ClearEdit
    | EditorFocused
    | SubmitEdit
    | CancelEdit
    | ReplyChanged { threadId : String, text : String }
    | SubmitReply String
    | ResolveThread String
    | InterruptTurn
    | StartReview
    | OpenBriefing
    | BriefChanged String
    | SubmitBriefing
    | CancelBriefing
    | ToggleSettings
    | ModelPicked String
    | ClearContext
    | ThemePicked String
    | ChangesShown Bool
    | ResolvedShown Bool
    | FocusThread String
    | FocusPassage String
    | ThreadScrolled
    | DocScrolled
    | DismissError


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        ServerFrame raw ->
            when Decode.decodeValue Protocol.serverMsgDecoder raw is
                Ok frame ->
                    applyServerMsg frame model

                Err err ->
                    stay { model | error = Just (Decode.errorToString err) }

        SelectionMade raw ->
            when Decode.decodeValue anchorDecoder raw is
                Ok anchor ->
                    if String.isEmpty (String.trim anchor.quote) then
                        -- A cleared selection — usually a stray click in the
                        -- document — closes an untouched composer but never one
                        -- with words in it. Those go away by Cancel or Escape,
                        -- which are deliberate.
                        stay { model | composing = keepIfWritten model.composing }

                    else
                        stay
                            { model
                                | composing =
                                    Just
                                        { anchor = anchor
                                        , draft = ""
                                        , sent = Nothing
                                        , stale = False
                                        , edit = Nothing
                                        }
                            }

                Err _ ->
                    stay { model | composing = keepIfWritten model.composing }

        ConnectionState state ->
            stay { model | connection = state }

        OpenDoc path ->
            { model = { model | composing = Nothing, opened = path, picking = Nothing }
            , command = socketOut (Protocol.openDoc path)
            }

        TogglePicker ->
            when model.picking is
                Just _ ->
                    stay { model | picking = Nothing }

                Nothing ->
                    -- The list opens on the document being read, because that
                    -- is what the reviewer is moving away from and the arrows
                    -- should start from where they are. The settings panel
                    -- closes: two panels hanging off one bar is noise.
                    let
                        cursor =
                            Array.findFirst (\path -> path == model.opened) model.docs
                                |> Maybe.map (\found -> found.index)
                                |> Maybe.withDefault 0
                    in
                    { model =
                        { model
                            | picking = Just { query = "", cursor = cursor }
                            , settingsOpen = False
                        }
                    , command =
                        Cmd.batch
                            [ focusPickerFilter
                            , showPickerRow cursor
                            ]
                    }

        ClosePicker ->
            stay { model | picking = Nothing }

        PickerTyped query ->
            when model.picking is
                Just _ ->
                    -- A new query is a new list, and the highlight belongs on
                    -- its first row: three letters in, the document wanted is
                    -- at the top rather than wherever the cursor had got to.
                    stay { model | picking = Just { query = query, cursor = 0 } }

                Nothing ->
                    stay model

        PickerMoved delta ->
            when model.picking is
                Just picking ->
                    let
                        cursor =
                            Picker.move (Array.length (shownDocs model picking)) delta picking.cursor
                    in
                    { model = { model | picking = Just { picking | cursor = cursor } }
                    , command = showPickerRow cursor
                    }

                Nothing ->
                    stay model

        PickerChose ->
            when model.picking is
                Just picking ->
                    let
                        shown =
                            shownDocs model picking
                    in
                    when Array.get (Picker.at (Array.length shown) picking.cursor) shown is
                        Just path ->
                            update (OpenDoc path) model

                        Nothing ->
                            stay model

                Nothing ->
                    stay model

        PickerSettled ->
            -- Nothing to do: the box took focus and the row came into view, or
            -- the panel is already gone.
            stay model

        DraftChanged text ->
            when model.composing is
                Just composing ->
                    stay { model | composing = Just { composing | draft = text } }

                Nothing ->
                    stay model

        SubmitComment ->
            when { composing = model.composing, doc = model.current } is
                { composing = Just composing, doc = Just doc } ->
                    -- The composer stays on screen, holding the text, until a
                    -- thread carrying this comment comes back. A comment the
                    -- server refuses — its passage edited away while the
                    -- reviewer typed — then leaves the words where they are
                    -- instead of behind an error banner.
                    if String.isEmpty (String.trim composing.draft) || composing.sent /= Nothing then
                        stay model

                    else
                        { model = { model | composing = Just { composing | sent = Just composing.draft } }
                        , command =
                            Cmd.batch
                                [ socketOut
                                    (Protocol.comment
                                        { doc = doc.path
                                        , anchor = composing.anchor
                                        , body = composing.draft
                                        }
                                    )
                                , clearSelection {}
                                ]
                        }

                _ ->
                    stay model

        CancelComment ->
            { model = { model | composing = Nothing }, command = clearSelection {} }

        StartEdit ->
            when { composing = model.composing, doc = model.current } is
                { composing = Just composing, doc = Just doc } ->
                    { model =
                        { model
                            | composing =
                                Just
                                    { composing
                                        | edit =
                                            Just
                                                { source = ""
                                                , draft = ""
                                                , ready = False
                                                , sent = False
                                                }
                                    }
                        }
                    , command =
                        socketOut
                            (Protocol.editSource { doc = doc.path, anchor = composing.anchor })
                    }

                _ ->
                    stay model

        EditChanged text ->
            stay
                { model | composing = mapEdit (\editing -> { editing | draft = text }) model.composing }

        ClearEdit ->
            -- The editor opens on the passage as it stands, which is the wrong
            -- starting point for the commonest hand edit there is: taking the
            -- words out. Selecting the box and deleting it is three gestures
            -- for one intention.
            --
            -- It empties the box and stops. Saving is still a separate press,
            -- so this is a step towards either an empty passage or a rewritten
            -- one, and Cancel is still the way back to what the file says.
            { model = { model | composing = mapEdit (\editing -> { editing | draft = "" }) model.composing }
            , command = focusEditSource
            }

        EditorFocused ->
            -- Nothing to do; the caret is in the box, or the box has gone.
            stay model

        SubmitEdit ->
            when { composing = model.composing, doc = model.current } is
                { composing = Just composing, doc = Just doc } ->
                    when composing.edit is
                        Just editing ->
                            -- Sending before the source has arrived would ask
                            -- the server to swap the passage for nothing.
                            if not editing.ready || editing.sent then
                                stay model

                            else
                                { model = { model | composing = Just { composing | edit = Just { editing | sent = True } } }
                                , command =
                                    socketOut
                                        (Protocol.applyEdit
                                            { doc = doc.path
                                            , anchor = composing.anchor
                                            , original = editing.source
                                            , replacement = editing.draft
                                            }
                                        )
                                }

                        Nothing ->
                            stay model

                _ ->
                    stay model

        CancelEdit ->
            -- Back to the comment, which still has whatever was typed into it.
            stay
                { model | composing = Maybe.map (\composing -> { composing | edit = Nothing }) model.composing }

        ReplyChanged change ->
            stay
                { model | replyDrafts = Dict.set change.threadId change.text model.replyDrafts }

        SubmitReply threadId ->
            let
                draft =
                    Dict.get threadId model.replyDrafts
                        |> Maybe.withDefault ""
            in
            if String.isEmpty (String.trim draft) then
                stay model

            else
                { model = { model | replyDrafts = Dict.remove threadId model.replyDrafts }
                , command = socketOut (Protocol.reply { threadId = threadId, body = draft })
                }

        ResolveThread threadId ->
            { model = model, command = socketOut (Protocol.resolve threadId) }

        InterruptTurn ->
            when model.current is
                Just doc ->
                    { model = model, command = socketOut (Protocol.interrupt doc.path) }

                Nothing ->
                    stay model

        StartReview ->
            -- No box to fill in. The brief is a setting, and asking for one
            -- every time is the bare trigger with friction in front of it.
            askForReview model ""

        OpenBriefing ->
            -- The one-off override, prefilled with the standing brief so the
            -- reviewer is editing something rather than facing an empty field.
            stay
                { model
                    | briefing = Just (standingBrief model)
                    , picking = Nothing
                    , settingsOpen = False
                }

        BriefChanged text ->
            stay { model | briefing = Just text }

        SubmitBriefing ->
            when model.briefing is
                Just brief ->
                    askForReview { model | briefing = Nothing } brief

                Nothing ->
                    stay model

        CancelBriefing ->
            stay { model | briefing = Nothing }

        ToggleSettings ->
            stay { model | settingsOpen = not model.settingsOpen, picking = Nothing }

        ModelPicked name ->
            -- The panel keeps showing the old model until the daemon confirms
            -- the change in a settings frame: what Claude is actually running
            -- is the server's answer to give, not the select element's.
            { model = model, command = socketOut (Protocol.setModel name) }

        ClearContext ->
            { model = model, command = socketOut Protocol.clearContext }

        ThemePicked theme ->
            { model = { model | theme = theme }, command = setTheme theme }

        ChangesShown wanted ->
            -- The passages themselves stay in the model. Turning the highlight
            -- off is a question about this page, not about the document, and
            -- turning it back on should not have to wait for a re-render.
            { model = { model | showChanges = wanted }, command = rememberChanges wanted }

        ResolvedShown wanted ->
            -- The threads stay in the model, as the changes do: this is a
            -- question about how full the column is, not about what is in it.
            { model = { model | showResolved = wanted }, command = rememberResolved wanted }

        FocusThread threadId ->
            -- The reviewer pointed at a highlighted passage, which is how you
            -- ask for the conversation about it.
            { model = model, command = showEndOfThread threadId }

        FocusPassage threadId ->
            -- The other way round: the reviewer pointed at a thread, and what
            -- they are asking is where in the document it is about. A comment
            -- they wrote themselves they can place from the words alone; one a
            -- review raised quotes a passage they have never seen.
            { model = model, command = showPassage threadId }

        ThreadScrolled ->
            -- Nothing to do; the scroll either happened or the thread was gone.
            stay model

        DocScrolled ->
            -- Nothing to do; the pane moved, or there was nothing to move it to.
            stay model

        DismissError ->
            stay { model | error = Nothing }


stay : Model -> { model : Model, command : Cmd Msg }
stay model =
    { model = model, command = Cmd.none }


applyServerMsg : ServerMsg -> Model -> { model : Model, command : Cmd Msg }
applyServerMsg frame model =
    when frame is
        DocUpdated payload ->
            -- Renders are broadcast, and the daemon re-renders whatever changed
            -- on disk — a document nobody has open, a whole branch's worth
            -- during a checkout. Only the one that was asked for is drawn;
            -- without that test the page moves off what the reviewer is reading
            -- whenever some other file is touched.
            --
            -- An anchor is text rather than offsets, so an edit elsewhere in
            -- the document leaves it perfectly valid and a re-render is no
            -- reason to throw a draft away. When the passage itself has gone,
            -- the composer says so and still keeps the words.
            if payload.doc.path == model.opened then
                { model = afterDocChange payload.doc payload.changes model
                , command =
                    -- A different document starts at its beginning. The pane
                    -- keeps whatever scroll position the last one left it at,
                    -- so opening a short file from halfway down a long one
                    -- arrives somewhere past its end, on blank space. Another
                    -- render of the same document is not a move and must leave
                    -- the reader where they were reading -- the daemon sends
                    -- one on every save, and on every edit the model makes.
                    if alreadyOpen payload.doc model.current then
                        Cmd.none

                    else
                        showTopOfDoc
                }

            else
                stay model

        ThreadsUpdated payload ->
            let
                found =
                    marksIn (plainTextOf model.current) payload.threads
            in
            { model =
                { model
                    | threads = inDocumentOrder found payload.threads
                    , marks = found
                    , composing = closeIfFiled payload.threads model.composing
                }
            , command =
                -- The comment just filed is at the end of a column that may be
                -- taller than the window, so it arrives off screen.
                when justFiled payload.threads model.composing is
                    Just threadId ->
                        showEndOfThread threadId

                    Nothing ->
                        Cmd.none
            }

        AssistantDelta payload ->
            stay { model | threads = appendDelta payload.threadId payload.text model.threads }

        TurnEnded payload ->
            -- The answer has landed and the reply box has appeared under it.
            -- Both are at the end of a thread that is often taller than the
            -- pane, so the pane goes to where the new words are.
            { model =
                { model
                    | threads =
                        mapThread payload.threadId
                            (\thread -> { thread | status = Open, commit = payload.commit })
                            model.threads
                }
            , command = showEndOfThread payload.threadId
            }

        BusyChanged payload ->
            stay { model | busy = payload.busy }

        PassProgress progress ->
            stay
                { model
                    | pass =
                        if progress.active && progress.doc == model.opened then
                            Just progress

                        else
                            Nothing
                }

        DocList docs ->
            stay { model | docs = docs }

        SettingsUpdated settings ->
            stay { model | settings = Just settings }

        EditSource payload ->
            stay { model | composing = fillSource payload (docPathOf model) model.composing }

        EditApplied payload ->
            -- The edit is in the file and committed; the editor has nothing
            -- left to hold on to.
            if waitingOnEdit payload (docPathOf model) model.composing then
                { model = { model | composing = Nothing }, command = clearSelection {} }

            else
                stay model

        ServerError message ->
            -- Whatever went wrong, nothing was filed: take what was in flight
            -- out of it so the reviewer can edit and send it again.
            stay
                { model
                    | error = Just message
                    , composing = Maybe.map afterFailure model.composing
                }


{-| Put a composer back the way it was before it sent anything.

The words are kept — they are the one thing the server cannot give back — but an
editor still waiting for its source has nothing to show and no way to be
dismissed, so it steps aside and leaves the comment behind it.

-}
afterFailure : Composing -> Composing
afterFailure composing =
    { composing
        | sent = Nothing
        , edit = Maybe.andThen unsend composing.edit
    }


unsend : Editing -> Maybe Editing
unsend editing =
    if editing.ready then
        Just { editing | sent = False }

    else
        Nothing


keepIfWritten : Maybe Composing -> Maybe Composing
keepIfWritten composing =
    when composing is
        Just active ->
            if active.edit == Nothing && String.isEmpty (String.trim active.draft) then
                Nothing

            else
                composing

        Nothing ->
            Nothing


mapEdit : (Editing -> Editing) -> Maybe Composing -> Maybe Composing
mapEdit fn composing =
    Maybe.map (\active -> { active | edit = Maybe.map fn active.edit }) composing


docPathOf : Model -> String
docPathOf model =
    when model.current is
        Just doc ->
            doc.path

        Nothing ->
            ""


{-| Take the source the server sent, if this composer is the one that asked.

Every frame goes to every connection, so a source arriving for a passage this
tab is not editing is ordinary and ignored — as is a second copy of one already
being edited, which would otherwise throw away what has been typed since.

-}
fillSource :
    { doc : String, quote : String, text : String }
    -> String
    -> Maybe Composing
    -> Maybe Composing
fillSource payload docPath composing =
    when composing is
        Just active ->
            when active.edit is
                Just editing ->
                    if editing.ready || payload.doc /= docPath || active.anchor.quote /= payload.quote then
                        composing

                    else
                        Just
                            { active
                                | edit =
                                    Just
                                        { editing
                                            | source = payload.text
                                            , draft = payload.text
                                            , ready = True
                                        }
                            }

                Nothing ->
                    composing

        Nothing ->
            composing


{-| Whether this tab is the one holding the edit that just landed.
-}
waitingOnEdit :
    { doc : String, quote : String, commit : String }
    -> String
    -> Maybe Composing
    -> Bool
waitingOnEdit payload docPath composing =
    when composing is
        Just active ->
            when active.edit is
                Just editing ->
                    editing.sent
                        && payload.doc == docPath
                        && active.anchor.quote == payload.quote

                Nothing ->
                    False

        Nothing ->
            False


{-| Fold a new render of the document into the model.

The document's plain text is searched here and nowhere else: once to place every
thread's quote, once to tell a draft whether the passage it was written against
is still there. Both answers are kept in the model, so drawing a frame never
searches the document again.

-}
afterDocChange : Doc -> Array Change -> Model -> Model
afterDocChange doc changes model =
    let
        plain =
            Marks.plainText (Doc.text doc.root)
    in
    { model
        | current = Just doc
        , threads = inDocumentOrder (marksIn plain model.threads) model.threads
        , marks = marksIn plain model.threads
        , changes = changes
        , composing =
            Maybe.map
                (\composing ->
                    { composing | stale = Marks.find plain (needleFor composing.anchor) == Nothing }
                )
                model.composing
    }


plainTextOf : Maybe Doc -> Array Char
plainTextOf current =
    when current is
        Just doc ->
            Marks.plainText (Doc.text doc.root)

        Nothing ->
            []


{-| Close the composer once the comment it sent has come back as a thread.

Matching on the text rather than acknowledging the request keeps the client from
needing request ids: the server broadcasts the thread list as soon as it accepts
a comment, and a rejected one never appears there.

-}
closeIfFiled : Array Thread -> Maybe Composing -> Maybe Composing
closeIfFiled threads composing =
    when composing is
        Just active ->
            when active.sent is
                Just sent ->
                    if Array.any (carries active.anchor.quote sent) threads then
                        Nothing

                    else
                        composing

                Nothing ->
                    composing

        Nothing ->
            Nothing


{-| The id of the thread carrying the comment this tab has in flight, if it has
just come back.
-}
justFiled : Array Thread -> Maybe Composing -> Maybe String
justFiled threads composing =
    when composing is
        Just active ->
            when active.sent is
                Just sent ->
                    Array.findFirst (carries active.anchor.quote sent) threads
                        |> Maybe.map (\found -> found.value.id)

                Nothing ->
                    Nothing

        Nothing ->
            Nothing


{-| Scroll the threads pane so the end of one thread is at the bottom of it.

The end is what matters rather than the start: a long exchange does not fit, and
what the reviewer is waiting for is the newest answer and the empty reply box
under it. Browser.Dom reads the DOM inside an animation frame, which is after
the frame this update is drawn in, so the measurements are of the thread as it
now stands rather than as it was.

-}
showEndOfThread : String -> Cmd Msg
showEndOfThread threadId =
    Dom.getElement (threadElementId threadId)
        |> Task.andThen
            (\thread ->
                Dom.getElement threadsPaneId
                    |> Task.andThen
                        (\pane ->
                            Dom.getViewportOf threadsPaneId
                                |> Task.andThen
                                    (\pane_ ->
                                        let
                                            -- Where the thread ends, measured
                                            -- from the top of everything the
                                            -- pane can scroll through.
                                            ends =
                                                pane_.viewport.y
                                                    + (thread.element.y + thread.element.height)
                                                    - pane.element.y
                                        in
                                        Dom.setViewportOf threadsPaneId 0 (ends - pane_.viewport.height + 12)
                                    )
                        )
            )
        |> Task.attempt (\_ -> ThreadScrolled)


threadsPaneId : String
threadsPaneId =
    "threads"


threadElementId : String -> String
threadElementId threadId =
    "thread-" ++ threadId


{-| Scroll the document pane to the passage a thread is anchored to.

Only when the passage is not on the page already: a highlight in front of the
reader is not a request to move the document, and moving it anyway costs them
the line they were on. When it does move, the passage lands a third of the way
down rather than against the top edge, because a sentence with nothing above it
is a sentence out of its context -- and the paragraph it belongs to is usually
the reason the comment is there.

-}
showPassage : String -> Cmd Msg
showPassage threadId =
    Dom.getElement (markElementId threadId)
        |> Task.andThen
            (\mark ->
                Dom.getElement docPaneId
                    |> Task.andThen
                        (\pane ->
                            Dom.getViewportOf docPaneId
                                |> Task.andThen
                                    (\scrolled ->
                                        let
                                            -- The passage's top and bottom
                                            -- measured from the top of
                                            -- everything the pane can scroll
                                            -- through.
                                            top =
                                                scrolled.viewport.y + mark.element.y - pane.element.y

                                            bottom =
                                                top + mark.element.height
                                        in
                                        if top >= scrolled.viewport.y && bottom <= scrolled.viewport.y + scrolled.viewport.height then
                                            Task.succeed {}

                                        else
                                            Dom.setViewportOf docPaneId 0 (max 0 (top - scrolled.viewport.height / 3))
                                    )
                        )
            )
        |> Task.attempt (\_ -> DocScrolled)


{-| The id of the mark a thread's passage starts at. Only its first mark carries
one: a quote that crosses a link or a soft wrap is drawn as several.
-}
markElementId : String -> String
markElementId threadId =
    "mark-" ++ threadId


{-| Whether a render that has arrived is of the document already on screen.
-}
alreadyOpen : Doc -> Maybe Doc -> Bool
alreadyOpen doc current =
    when current is
        Just shown ->
            shown.path == doc.path

        Nothing ->
            False


{-| Put the document pane back at the top, for a document that has just opened.
-}
showTopOfDoc : Cmd Msg
showTopOfDoc =
    Dom.setViewportOf docPaneId 0 0
        |> Task.attempt (\_ -> DocScrolled)


docPaneId : String
docPaneId =
    "doc-pane"


{-| Scroll the picker's list so the highlighted row is in it.

Only when it is not: a list being walked with the arrow keys should move by the
one row it has to and no further, so that the rows around the highlight stay
where the eye left them. Without this the keyboard walks off the bottom of a
scrolling list and the highlight is somewhere nobody can see.

-}
showPickerRow : Int -> Cmd Msg
showPickerRow cursor =
    Dom.getElement (pickerRowId cursor)
        |> Task.andThen
            (\row ->
                Dom.getElement pickerListId
                    |> Task.andThen
                        (\list ->
                            Dom.getViewportOf pickerListId
                                |> Task.andThen
                                    (\pane ->
                                        let
                                            -- The row's top and bottom measured
                                            -- from the top of everything the
                                            -- list can scroll through.
                                            top =
                                                pane.viewport.y + row.element.y - list.element.y

                                            bottom =
                                                top + row.element.height
                                        in
                                        if top < pane.viewport.y then
                                            Dom.setViewportOf pickerListId 0 top

                                        else if bottom > pane.viewport.y + pane.viewport.height then
                                            Dom.setViewportOf pickerListId 0 (bottom - pane.viewport.height)

                                        else
                                            Task.succeed {}
                                    )
                        )
            )
        |> Task.attempt (\_ -> PickerSettled)


{-| Put the caret in the filter box as the picker opens.

`autofocus` is not enough. It is honoured for elements that are in the page when
it loads, and this input is inserted long afterwards; without this the keys go
to whatever had focus -- the button that opened the panel, which then treats the
space in "release notes" as another click and shuts it again.

-}
focusPickerFilter : Cmd Msg
focusPickerFilter =
    Dom.focus pickerFilterId
        |> Task.attempt (\_ -> PickerSettled)


pickerFilterId : String
pickerFilterId =
    "picker-filter"


{-| Put the caret back in the source box after the Clear button took it.

A button keeps the focus it was given, so without this the reviewer who cleared
the passage in order to type something else has to click into the box before
they can.

-}
focusEditSource : Cmd Msg
focusEditSource =
    Dom.focus editSourceId
        |> Task.attempt (\_ -> EditorFocused)


editSourceId : String
editSourceId =
    "edit-source"


pickerListId : String
pickerListId =
    "picker-list"


pickerRowId : Int -> String
pickerRowId cursor =
    "picker-row-" ++ String.fromInt cursor


carries : String -> String -> Thread -> Bool
carries quote body thread =
    thread.anchor.quote == quote
        && Array.any
            (\message -> message.role == User && message.text == body)
            thread.messages


{-| Streamed assistant text arrives in fragments; each one extends the thread's
trailing assistant message, or starts a new one if the reviewer spoke last.
-}
appendDelta : String -> String -> Array Thread -> Array Thread
appendDelta threadId text threads =
    mapThread threadId
        (\thread ->
            let
                lastIndex =
                    Array.length thread.messages - 1
            in
            when Array.get lastIndex thread.messages is
                Just last ->
                    if last.role == Assistant then
                        { thread
                            | messages =
                                Array.set lastIndex
                                    { last | text = last.text ++ text }
                                    thread.messages
                        }

                    else
                        { thread | messages = Array.pushLast { role = Assistant, text = text } thread.messages }

                Nothing ->
                    { thread | messages = Array.pushLast { role = Assistant, text = text } thread.messages }
        )
        threads


mapThread : String -> (Thread -> Thread) -> Array Thread -> Array Thread
mapThread threadId fn threads =
    Array.map
        (\thread ->
            if thread.id == threadId then
                fn thread

            else
                thread
        )
        threads


anchorDecoder : Decode.Decoder Anchor
anchorDecoder =
    Decode.map4
        (\nodeId quote prefix suffix ->
            { nodeId = nodeId, quote = quote, prefix = prefix, suffix = suffix }
        )
        (Decode.field "nodeId" Decode.string)
        (Decode.field "quote" Decode.string)
        (Decode.field "prefix" Decode.string)
        (Decode.field "suffix" Decode.string)


askForReview : Model -> String -> { model : Model, command : Cmd Msg }
askForReview model brief =
    when model.current is
        Just doc ->
            { model = model
            , command = socketOut (Protocol.review { doc = doc.path, brief = brief })
            }

        Nothing ->
            stay model


{-| What a pass looks for when nobody says: whatever the daemon read out of
`.ai-reviewer/review.md`, or the one it ships with.
-}
standingBrief : Model -> String
standingBrief model =
    when model.settings is
        Just settings ->
            settings.brief

        Nothing ->
            ""


-- SUBSCRIPTIONS


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.batch
        [ socketIn ServerFrame
        , selectionIn SelectionMade
        , socketState ConnectionState
        ]


-- VIEW


view : Model -> Html Msg
view model =
    Html.div
        [ Attr.class "app" ]
        [ viewTopBar model
        , viewError model.error
        , Html.div
            [ Attr.class "body" ]
            [ viewDocument model
            , viewSidebar model
            ]
        , viewComposer model.composing
        , viewBriefing model
        ]


viewTopBar : Model -> Html Msg
viewTopBar model =
    Html.header
        [ Attr.class "topbar" ]
        [ viewDocButton model
        , viewReviewButtons model
        , Html.div
            [ Attr.class "state" ]
            [ viewWorking model
            , viewResolvedButton model
            , viewSettingsButton model
            , viewConnection model.connection
            ]
        , viewDocPicker model
        , viewSettingsPanel model
        ]


{-| Ask the model to read the document and raise its own comments.

Two controls, not one. The first is the trigger and takes no argument: the brief
is a setting, and a reviewer who had to type one every time would type "review
this", which is the bare trigger with a form in front of it. The second is the
one-off, for the pass that is looking for something particular today.

Both are hidden with no document open, because there is nothing to review.

-}
viewReviewButtons : Model -> Html Msg
viewReviewButtons model =
    if model.current == Nothing then
        Html.text ""

    else
        Html.div
            [ Attr.class "review-controls" ]
            [ Html.button
                [ Attr.class "review"
                , Attr.title "Read this document and raise comments on it"
                , Attr.disabled (model.pass /= Nothing)
                , Events.onClick StartReview
                ]
                [ Html.text "Review" ]
            , Html.button
                [ Attr.class "review-brief secondary"
                , Attr.title "Review it for something in particular"
                , Attr.disabled (model.pass /= Nothing)
                , Events.onClick OpenBriefing
                ]
                [ Html.text "for…" ]
            ]


{-| Put the answered threads away.

A review fills the column faster than anyone answers it, and every thread that
has been dealt with is a card between the reviewer and the ones that have not.
Resolving is already the way to say "done with this"; this is the other half of
it, and it belongs in the bar rather than in the settings panel because it is
used while reading rather than set once.

The label says what the click will do and how much of the column it is about, so
nothing has to be drawn to say which way the toggle is -- and with nothing
resolved yet there is no button at all, which is most of a session.

-}
viewResolvedButton : Model -> Html Msg
viewResolvedButton model =
    let
        resolved =
            Array.length (Array.keepIf (\thread -> thread.status == Resolved) model.threads)
    in
    if resolved == 0 then
        Html.text ""

    else
        Html.button
            [ Attr.classList
                [ { class = "resolved-toggle", enabled = True }
                , { class = "active", enabled = not model.showResolved }
                ]
            , Attr.title "Resolved threads are the ones already dealt with"
            , Events.onClick (ResolvedShown (not model.showResolved))
            ]
            [ Html.text
                ((if model.showResolved then
                    "hide "

                  else
                    "show "
                 )
                    ++ String.fromInt resolved
                    ++ " resolved"
                )
            ]


{-| What the daemon is doing, and the way to stop it.

A pass says where it has got to, because a run of eight sections is a wait with
a shape and "thinking" says nothing about how long is left. A turn answering one
comment has no such shape and does not pretend to.

-}
viewWorking : Model -> Html Msg
viewWorking model =
    when model.pass is
        Just progress ->
            Html.button
                [ Attr.class "interrupt", Events.onClick InterruptTurn ]
                [ Html.text (passLabel progress ++ " — interrupt") ]

        Nothing ->
            if model.busy then
                Html.button
                    [ Attr.class "interrupt", Events.onClick InterruptTurn ]
                    [ Html.text "thinking — interrupt" ]

            else
                Html.text ""


passLabel : Protocol.Pass -> String
passLabel progress =
    let
        where_ =
            "reviewing "
                ++ String.fromInt progress.section
                ++ " of "
                ++ String.fromInt progress.total
    in
    if String.isEmpty progress.title then
        where_

    else
        where_ ++ " · " ++ progress.title


{-| The one-off brief, over the page like the composer.

Prefilled with the standing brief rather than empty: a reviewer does not know
what to ask for until they have seen what is there, and an empty field invites
"review this" -- which is a brief that says nothing, and gets a comment on every
paragraph in return.

-}
viewBriefing : Model -> Html Msg
viewBriefing model =
    when model.briefing is
        Nothing ->
            Html.text ""

        Just draft ->
            Html.div
                [ Attr.class "briefing" ]
                [ Html.label [] [ Html.text "Review this document for:" ]
                , Html.textarea
                    [ Attr.class "brief"
                    , Attr.value draft
                    , Events.onInput BriefChanged
                    , composerKeys { submit = SubmitBriefing, cancel = Just CancelBriefing }
                    ]
                    []
                , Html.div [ Attr.class "presets" ] (Array.map viewPreset briefPresets)
                , Html.div
                    [ Attr.class "actions" ]
                    [ Html.button [ Events.onClick SubmitBriefing ] [ Html.text "Review" ]
                    , Html.button
                        [ Attr.class "secondary", Events.onClick CancelBriefing ]
                        [ Html.text "Cancel" ]
                    ]
                ]


{-| A few briefs worth having, which fill the box rather than replace it. They
are there to say what the thing is good at; the box is still the answer.
-}
briefPresets : Array String
briefPresets =
    [ "Check the claims. Where the document says something is true, say whether it is, and say what you checked."
    , "Cut what repeats. Point at passages that say again what an earlier one already said."
    , "Read it as someone doing what it describes. Say where they would get stuck for want of a step that is not here."
    ]


viewPreset : String -> Html Msg
viewPreset brief =
    Html.button
        [ Attr.class "preset secondary"
        , Attr.title brief
        , Events.onClick (BriefChanged brief)
        ]
        [ Html.text (String.takeFirst 28 brief ++ "…") ]


{-| The socket to the daemon, in one word.

"open" was the word the port uses, and on screen it read as something about the
document — a file being open, a thread being open. What it is about is whether
this page is still being told anything.

-}
viewConnection : String -> Html Msg
viewConnection state =
    let
        label =
            when state is
                "open" ->
                    "connected"

                "connecting" ->
                    "connecting…"

                _ ->
                    "disconnected"
    in
    Html.span
        [ Attr.class ("conn conn-" ++ state)
        , Attr.title "This page's connection to the review daemon"
        ]
        [ Html.text label ]


{-| The button names the model rather than saying "settings", because the model
is the setting anyone actually wants to check.
-}
viewSettingsButton : Model -> Html Msg
viewSettingsButton model =
    when model.settings is
        Nothing ->
            Html.text ""

        Just settings ->
            Html.button
                [ Attr.classList
                    [ { class = "settings-toggle", enabled = True }
                    , { class = "active", enabled = model.settingsOpen }
                    ]
                , Events.onClick ToggleSettings
                ]
                [ Html.text (modelLabel settings), Html.span [ Attr.class "caret" ] [ Html.text "▾" ] ]


{-| What to call the model in one word.

The configured name is what the reviewer chose, but it is empty by default --
the daemon asks for no model at all and lets the CLI decide -- so the resolved
name is what gets shown until there is a choice to report.

-}
modelLabel : Protocol.Settings -> String
modelLabel settings =
    if not (String.isEmpty settings.model) then
        settings.model

    else if not (String.isEmpty settings.runningModel) then
        shortModel settings.runningModel

    else
        "default model"


{-| "claude-sonnet-5" reads as "sonnet" in a toolbar. The full name is in the
panel, where there is room for it.
-}
shortModel : String -> String
shortModel name =
    when Array.findFirst (\family -> String.contains family name) [ "opus", "sonnet", "haiku", "fable" ] is
        Just found ->
            found.value

        Nothing ->
            name


viewSettingsPanel : Model -> Html Msg
viewSettingsPanel model =
    when { open = model.settingsOpen, settings = model.settings } is
        { open = True, settings = Just settings } ->
            Html.div
                [ Attr.class "settings" ]
                (Array.flatten
                    [ [ viewModelRow settings
                      , viewConversationRow settings (docPathOf model)
                      , viewThemeRow model.theme
                      , viewChangesRow model
                      ]
                    , viewSettingRows settings
                    ]
                )

        _ ->
            Html.text ""


viewModelRow : Protocol.Settings -> Html Msg
viewModelRow settings =
    Html.div
        [ Attr.class "setting model" ]
        [ Html.span [ Attr.class "label" ] [ Html.text "model" ]
        , Html.div
            [ Attr.class "value" ]
            [ Html.select
                [ Events.onInput ModelPicked ]
                (Array.map (viewModelChoice settings.model) settings.modelChoices)
            , if String.isEmpty settings.runningModel then
                Html.p
                    [ Attr.class "note" ]
                    [ Html.text "no turn has run yet" ]

              else
                Html.p
                    [ Attr.class "note" ]
                    [ Html.text ("running " ++ settings.runningModel) ]
            , Html.p
                [ Attr.class "note" ]
                [ Html.text "a change applies to the next comment; the conversation continues" ]
            , Html.button
                [ Attr.class "secondary clear-context"
                , Attr.title "Start the next comment on each document from a new conversation"
                , Events.onClick ClearContext
                ]
                [ Html.text "Clear context" ]
            , Html.p
                [ Attr.class "note" ]
                [ Html.text "forgets what has been said, everywhere; your comment threads stay" ]
            ]
        ]


viewModelChoice : String -> String -> Html Msg
viewModelChoice current name =
    Html.option
        [ Attr.value name, Attr.selected (name == current) ]
        [ Html.text
            (if String.isEmpty name then
                "default (your claude config)"

             else
                name
            )
        ]


{-| How much conversation the open document is carrying.

It sits under the button that throws it away, because that is the number the
decision turns on: a comment costs the whole conversation behind it, every turn,
and nothing else on screen says how big that has become.

-}
viewConversationRow : Protocol.Settings -> String -> Html Msg
viewConversationRow settings docPath =
    let
        here =
            Array.findFirst (\conversation -> conversation.doc == docPath) settings.conversations
                |> Maybe.map (\found -> found.value)
    in
    Html.div
        [ Attr.class "setting" ]
        [ Html.span [ Attr.class "label" ] [ Html.text "conversation" ]
        , Html.div
            [ Attr.class "value" ]
            (Array.flatten
                [ [ Html.div [] [ Html.text (conversationLabel here) ] ]
                , when elsewhere settings docPath is
                    Just note ->
                        [ Html.p [ Attr.class "note" ] [ Html.text note ] ]

                    Nothing ->
                        []
                ]
            )
        ]


conversationLabel : Maybe Protocol.Conversation -> String
conversationLabel here =
    when here is
        Just conversation ->
            turnCount conversation.turns ++ ", $" ++ money conversation.spentUsd

        Nothing ->
            "nothing said yet"


turnCount : Int -> String
turnCount turns =
    if turns == 1 then
        "1 turn"

    else
        String.fromInt turns ++ " turns"


{-| What the other documents are carrying, since Clear context takes them all.
-}
elsewhere : Protocol.Settings -> String -> Maybe String
elsewhere settings docPath =
    let
        others =
            Array.keepIf (\conversation -> conversation.doc /= docPath) settings.conversations

        turns =
            Array.foldl (\conversation total -> total + conversation.turns) 0 others

        spent =
            Array.foldl (\conversation total -> total + conversation.spentUsd) 0 others
    in
    if Array.isEmpty others then
        Nothing

    else
        Just
            ("and "
                ++ turnCount turns
                ++ ", $"
                ++ money spent
                ++ " on "
                ++ documentCount (Array.length others)
            )


documentCount : Int -> String
documentCount documents =
    if documents == 1 then
        "one other document"

    else
        String.fromInt documents ++ " other documents"


{-| Light, dark, or whatever the machine says.

The two things in this panel the reviewer can change are next to each other, and
this one is theirs rather than the review's: it is remembered in this browser,
not in the daemon, so two people reading the same review can disagree about it.

-}
viewThemeRow : String -> Html Msg
viewThemeRow theme =
    Html.div
        [ Attr.class "setting model" ]
        [ Html.span [ Attr.class "label" ] [ Html.text "theme" ]
        , Html.div
            [ Attr.class "value" ]
            [ Html.select
                [ Events.onInput ThemePicked ]
                (Array.map (viewThemeChoice theme)
                    [ { value = "auto", label = "auto (follow this machine)" }
                    , { value = "light", label = "light" }
                    , { value = "dark", label = "dark" }
                    ]
                )
            ]
        ]


{-| Whether to tint what has changed since the session started.

The count is the reason this is a row rather than a bare checkbox: a document
with nothing marked on it looks exactly like one whose highlight is switched
off, and the reviewer who wonders which they are looking at deserves an answer
without having to toggle it and see.

-}
viewChangesRow : Model -> Html Msg
viewChangesRow model =
    Html.div
        [ Attr.class "setting model" ]
        [ Html.span [ Attr.class "label" ] [ Html.text "changes" ]
        , Html.div
            [ Attr.class "value" ]
            [ Html.label
                [ Attr.class "toggle" ]
                [ Html.input
                    [ Attr.type_ "checkbox"
                    , Attr.checked model.showChanges
                    , Events.onCheck ChangesShown
                    ]
                    []
                , Html.text "tint what changed since this session started"
                ]
            , Html.p [ Attr.class "note" ] [ Html.text (changesNote model) ]
            ]
        ]


changesNote : Model -> String
changesNote model =
    when Array.length model.changes is
        0 ->
            if model.current == Nothing then
                "no document open"

            else
                "nothing has changed yet"

        1 ->
            "1 passage on this page"

        n ->
            String.fromInt n ++ " passages on this page"


viewThemeChoice : String -> { value : String, label : String } -> Html Msg
viewThemeChoice current choice =
    Html.option
        [ Attr.value choice.value, Attr.selected (choice.value == current) ]
        [ Html.text choice.label ]


viewSettingRows : Protocol.Settings -> Array (Html Msg)
viewSettingRows settings =
    Array.flatten
        [ [ setting "tools" (String.join ", " settings.tools)
          , setting "permissions" settings.permissionMode
          , setting "claude runs in" settings.workspace
          ]
        , if settings.reviewRoot == settings.workspace then
            []

          else
            [ setting "reviewing" settings.reviewRoot ]
        , if String.isEmpty settings.branch then
            []

          else
            [ viewBranch settings ]
        , [ setting "spent" (spendLabel settings)
          , setting "processes" (String.fromInt settings.live ++ " running")
          , setting "claude" (claudeLabel settings)
          ]
        ]


{-| The version, and the path only when it is not simply whatever is on PATH --
which is the answer to "is it even the claude I think it is?" without adding a
line that says "claude" to everybody else.
-}
claudeLabel : Protocol.Settings -> String
claudeLabel settings =
    let
        version =
            if String.isEmpty settings.cliVersion then
                "version unknown"

            else
                settings.cliVersion
    in
    if settings.cliPath == "claude" || String.isEmpty settings.cliPath then
        version

    else
        version ++ " — " ++ settings.cliPath


{-| The review's commits: where they are, how many, and how to land them.

The daemon does not merge. A merge can conflict, and a conflict raised inside a
page that has no diff and no way out is worse than no button at all -- so what
the panel offers is the commands, ready to be read and run somewhere that can
answer it.

Both merges are offered, each with the delete that follows it, because the
reviewer is as often a writer as a programmer: a branch name and the word
"merge" are not an instruction to someone who has never typed one.

-}
viewBranch : Protocol.Settings -> Html Msg
viewBranch settings =
    Html.div
        [ Attr.class "setting" ]
        [ Html.span [ Attr.class "label" ] [ Html.text "branch" ]
        , Html.div
            [ Attr.class "value" ]
            (Array.flatten
                [ [ Html.div [] [ Html.text settings.branch ]
                  , Html.p [ Attr.class "note" ] [ Html.text (commitsLabel settings) ]
                  ]
                , viewLanding settings.landing
                ]
            )
        ]


{-| The two ways a review ends, each with its delete, under the words that say
what it does.

The deletes differ, and the panel shows both rather than one with a caveat: a
squash leaves git unable to see the commits landed, so it refuses `-d` on the
branch. The words over `-D` carry the check that `-d` would have done, since
that check is now the reviewer's to make.

-}
viewLanding : Protocol.Landing -> Array (Html Msg)
viewLanding landing =
    if String.isEmpty landing.merge then
        []

    else
        [ viewCommand "keep the commits, one per turn" landing.merge
        , viewCommand "then, if you want the branch gone" landing.delete
        , viewCommand "or fold the review into one commit" landing.squash
        , viewCommand
            "then, once you have looked at what landed — a squash hides that from git, so -d is refused"
            landing.squashDelete
        ]


viewCommand : String -> String -> Html Msg
viewCommand why command =
    Html.div
        [ Attr.class "landing" ]
        [ Html.p [ Attr.class "note" ] [ Html.text why ]
        , Html.pre
            [ Attr.class "merge"
            , Attr.title "Run this where git can answer a conflict"
            ]
            [ Html.text command ]
        ]


{-| How many commits are waiting, and where they are waiting to go.

The count is what the branch has that its base does not, so it says "nothing to
merge" the moment they have been merged -- including from a terminal, which the
daemon would otherwise never hear about.

-}
commitsLabel : Protocol.Settings -> String
commitsLabel settings =
    let
        counted =
            if settings.commits == 1 then
                "1 commit"

            else
                String.fromInt settings.commits ++ " commits"
    in
    if settings.commits == 0 then
        "nothing recorded yet"

    else if String.isEmpty settings.baseBranch then
        counted ++ " on it"

    else
        counted ++ " not yet in " ++ settings.baseBranch


setting : String -> String -> Html Msg
setting label value =
    Html.div
        [ Attr.class "setting" ]
        [ Html.span [ Attr.class "label" ] [ Html.text label ]
        , Html.span [ Attr.class "value" ] [ Html.text value ]
        ]


{-| Spend since this daemon started -- a resumed conversation from an earlier
run does not carry its cost forward, so the panel says what the number means.
-}
spendLabel : Protocol.Settings -> String
spendLabel settings =
    let
        spent =
            "$" ++ money settings.spentUsd ++ " this session"
    in
    if settings.maxBudgetUsd > 0 then
        spent ++ ", cap $" ++ money settings.maxBudgetUsd ++ " per process"

    else
        spent


money : Float -> String
money amount =
    let
        cents =
            Math.round (amount * 100)
    in
    String.fromInt (cents // 100)
        ++ "."
        ++ String.padLeft 2 '0' (String.fromInt (Math.modBy 100 cents))


{-| The documents the picker is offering: all of them, less what the query rules
out.
-}
shownDocs : Model -> Picking -> Array String
shownDocs model picking =
    Picker.matching picking.query model.docs


{-| The name of the open document, and the way to every other one.

This is where a strip of tabs used to be, one per document, and it did not
survive being pointed at a repository: the server lists every `.md` under the
review root, and fifty of them scroll sideways in a strip that can push the
document being read out of sight. What a top bar owes the reviewer is the name
of the thing they are reading; the rest is a list, and a list belongs behind a
button.

-}
viewDocButton : Model -> Html Msg
viewDocButton model =
    Html.button
        [ Attr.classList
            [ { class = "doc-toggle", enabled = True }
            , { class = "active", enabled = model.picking /= Nothing }
            ]
        , Attr.title "Choose a document to review"
        , Events.onClick TogglePicker
        ]
        [ Html.span
            [ Attr.class "doc-open" ]
            [ Html.text
                (if String.isEmpty model.opened then
                    "choose a document"

                 else
                    model.opened
                )
            ]
        , Html.span [ Attr.class "caret" ] [ Html.text "▾" ]
        ]


{-| The list of documents, filtered by what has been typed into it.

Typing narrows, the arrows walk, Enter opens and Escape closes -- the keyboard
alone is enough, which is the point of a filter box over a strip of tabs. The
rows are grouped under their folder because a repository's Markdown is mostly
`README.md` files that only differ by which directory they are in.

-}
viewDocPicker : Model -> Html Msg
viewDocPicker model =
    when model.picking is
        Nothing ->
            Html.text ""

        Just picking ->
            let
                shown =
                    shownDocs model picking
            in
            Html.div
                [ Attr.class "picker" ]
                [ Html.input
                    [ Attr.class "picker-filter"
                    , Attr.id pickerFilterId
                    , Attr.type_ "text"
                    , Attr.placeholder "filter by name or folder…"
                    , Attr.value picking.query
                    , Attr.spellcheck False
                    , Events.onInput PickerTyped
                    , pickerKeys
                    ]
                    []
                , Html.div
                    [ Attr.class "picker-list", Attr.id pickerListId ]
                    (viewPickerRows
                        { opened = model.opened
                        , cursor = Picker.at (Array.length shown) picking.cursor
                        }
                        shown
                    )
                , Html.p
                    [ Attr.class "note" ]
                    [ Html.text (pickerNote { shown = Array.length shown, all = Array.length model.docs }) ]
                ]


{-| What the list has to say about itself: a count, or why it is empty.
-}
pickerNote : { shown : Int, all : Int } -> String
pickerNote counts =
    if counts.all == 0 then
        "no Markdown under the review root"

    else if counts.shown == 0 then
        "nothing matches, out of " ++ documentTally counts.all

    else if counts.shown == counts.all then
        documentTally counts.all

    else
        String.fromInt counts.shown ++ " of " ++ documentTally counts.all


{-| A plain count of documents. `documentCount` in the settings panel counts the
*other* documents, which is a different sentence.
-}
documentTally : Int -> String
documentTally count =
    if count == 1 then
        "one document"

    else
        String.fromInt count ++ " documents"


{-| The rows, with a folder's name above the first document in it.

A heading appears wherever the folder changes, which is every place it needs to
because the server sends the paths sorted and a filter only ever removes rows. A
row's index is its position in the list the cursor counts, so the headings are
pushed in beside the rows they belong to rather than being a separate pass with
its own idea of the numbering.

-}
viewPickerRows : { opened : String, cursor : Int } -> Array String -> Array (Html Msg)
viewPickerRows state shown =
    Array.indexedMap
        (\index path ->
            let
                -- The first row always gets one; after that, only where the
                -- folder changes. The test is written this way round because
                -- `Array.get -1` is the *last* element, not nothing, and the
                -- first row of a filtered list that happens to end in the same
                -- folder would quietly lose its heading.
                heading =
                    if index == 0 then
                        True

                    else
                        when Array.get (index - 1) shown is
                            Just above ->
                                Picker.folder above /= Picker.folder path

                            Nothing ->
                                True
            in
            if heading then
                [ viewPickerFolder (Picker.folder path), viewPickerRow state index path ]

            else
                [ viewPickerRow state index path ]
        )
        shown
        |> Array.flatten


{-| A folder's heading. The root of the review is "/", having no name here: the
client is told relative paths and never learns what the directory is called.
-}
viewPickerFolder : String -> Html Msg
viewPickerFolder folder =
    Html.div
        [ Attr.class "picker-folder" ]
        [ Html.text
            (if String.isEmpty folder then
                "/"

             else
                folder ++ "/"
            )
        ]


viewPickerRow : { opened : String, cursor : Int } -> Int -> String -> Html Msg
viewPickerRow state index path =
    let
        isOpen =
            path == state.opened
    in
    Html.button
        [ Attr.classList
            [ { class = "picker-doc", enabled = True }
            , { class = "on", enabled = index == state.cursor }
            , { class = "open", enabled = isOpen }
            ]
        , Attr.id (pickerRowId index)
        , Attr.title
            (if isOpen then
                -- Choosing the open document re-reads it from disk. Worth
                -- saying, because nothing about a row suggests that the one
                -- already open does anything at all.
                "Reload " ++ path ++ " from disk"

             else
                "Open " ++ path
            )
        , Events.onClick (OpenDoc path)
        ]
        [ Html.text (Picker.name path) ]


{-| The four keys the filter box answers to: the arrows walk the list, Enter
opens the row under the highlight, Escape puts the list away.

The arrows and Enter have to preventDefault. Enter in a text input submits
something in some browsers, and the arrows move the caret inside the query --
which looks like nothing happening, in a box whose contents are one line long.

-}
pickerKeys : Html.Attribute Msg
pickerKeys =
    Events.preventDefaultOn "keydown"
        (Decode.field "key" Decode.string
            |> Decode.andThen pickerKey
        )


pickerKey : String -> Decode.Decoder { message : Msg, preventDefault : Bool }
pickerKey key =
    when key is
        "ArrowDown" ->
            Decode.succeed { message = PickerMoved 1, preventDefault = True }

        "ArrowUp" ->
            Decode.succeed { message = PickerMoved (-1), preventDefault = True }

        "Enter" ->
            Decode.succeed { message = PickerChose, preventDefault = True }

        "Escape" ->
            Decode.succeed { message = ClosePicker, preventDefault = False }

        _ ->
            Decode.fail "not a picker key"


viewError : Maybe String -> Html Msg
viewError maybeError =
    when maybeError is
        Just message ->
            Html.div
                [ Attr.class "error", Events.onClick DismissError ]
                [ Html.text message ]

        Nothing ->
            Html.text ""


{-| The document, drawn only when something about the document has changed.

Everything else in the model redraws on a keystroke -- a letter typed into a
reply is a new model, and `view` runs again over all of it. The threads column
that letter belongs to is a dozen cards and diffing it is nothing; this pane is
several thousand nodes, each one splitting its text around the passages that
cover it, and rebuilding all of that to discover that not a word of it moved
measured at 42ms a keystroke on a hundred-kilobyte document. Typing lagged, and
the lag was in the half of the page not being typed into.

`lazy` compares its arguments and reuses the tree it built last time when they
have not changed. They are passed one by one, straight out of the model, rather
than as one record assembled here: a record built on the way past is a new
record every time, and the thunk would never hit.

-}
viewDocument : Model -> Html Msg
viewDocument model =
    Html.main_
        [ Attr.class "doc", Attr.id docPaneId ]
        [ Html.Lazy.lazy4 viewDocumentBody model.current model.marks model.changes model.showChanges ]


viewDocumentBody : Maybe Doc -> Array Range -> Array Change -> Bool -> Html Msg
viewDocumentBody current marks changes showChanges =
    when current is
        Just doc ->
            .html
                (viewNode
                    { marks = marks
                    , changes =
                        if showChanges then
                            changes

                        else
                            []
                    }
                    0
                    doc.root
                )

        Nothing ->
            Html.p [ Attr.class "empty" ] [ Html.text "Select a document." ]


-- DOCUMENT RENDERING
--
-- The tree is walked once, carrying the offset the walk has reached in the
-- document's plain text -- the same text the quotes were located in. That
-- offset is what lets a highlight span nodes: each leaf splits itself wherever
-- a range begins or ends, and a range running past the leaf simply continues
-- into the next one.


{-| The two things drawn over the words: the passages comments are anchored to,
and the passages that have changed since the session started. They travel
together because every leaf has to ask both.
-}
type alias Marking =
    { marks : Array Range
    , changes : Array Change
    }


{-| Render a node, and report where the walk has reached.
-}
viewNode : Marking -> Int -> Node -> { html : Html Msg, next : Int }
viewNode over offset node =
    let
        own =
            markUp over offset (ownText node)

        kids =
            viewChildren over own.next node
    in
    { html = element node own.html kids.html
    , next = kids.next
    }


viewChildren : Marking -> Int -> Node -> { html : Array (Html Msg), next : Int }
viewChildren over offset node =
    Array.foldl
        (\child acc ->
            let
                walked =
                    viewNode over acc.next child
            in
            { html = Array.pushLast walked.html acc.html, next = walked.next }
        )
        { html = [], next = offset }
        (Doc.children node)


{-| The text a node contributes itself, before its children.

This has to agree with `Doc.text` exactly, down to the space a line break stands
for: the offsets counted here index the string the quotes were found in, so a
node that miscounts moves every highlight after it.

-}
ownText : Node -> String
ownText node =
    when Doc.kind node is
        Text raw ->
            raw

        CodeSpan raw ->
            raw

        CodeBlock code ->
            code.text

        HtmlBlock raw ->
            raw

        RawHtml raw ->
            raw

        LineBreak ->
            " "

        _ ->
            ""


{-| Assemble one element from its own text and its children, both already
rendered. Nothing here knows about offsets.
-}
element : Node -> Array (Html Msg) -> Array (Html Msg) -> Html Msg
element node own kids =
    when Doc.kind node is
        Document ->
            Html.Keyed.node "article" (attrs node "prose") (keyed node kids)

        Paragraph ->
            Html.p (attrs node "") kids

        Heading level ->
            headingTag level (attrs node "") kids

        CodeBlock code ->
            Html.pre
                (attrs node ("code lang-" ++ code.lang))
                [ Html.code [] own ]

        BlockQuote ->
            Html.blockquote (attrs node "") kids

        ListBlock list ->
            if list.ordered then
                Html.Keyed.ol (orderedAttrs node list.start) (keyed node kids)

            else
                Html.Keyed.ul (attrs node "") (keyed node kids)

        ListItem item ->
            when item.checked is
                Just isChecked ->
                    Html.li
                        (attrs node "task")
                        (Array.pushFirst (viewCheckbox isChecked) kids)

                Nothing ->
                    Html.li (attrs node "") kids

        ThematicBreak ->
            Html.hr (attrs node "") []

        HtmlBlock _ ->
            -- Raw HTML is shown as source, never injected. A document under
            -- review can contain anything, and rendering it would hand the page
            -- over to whatever the author wrote.
            Html.pre (attrs node "raw-html") own

        Table ->
            Html.table (attrs node "") kids

        TableRow row ->
            if row.header then
                Html.thead [] [ Html.tr (attrs node "") kids ]

            else
                Html.tbody [] [ Html.tr (attrs node "") kids ]

        TableCell cell ->
            let
                cellAttrs =
                    Array.pushLast (alignStyle cell.align) (attrs node "")
            in
            if cell.header then
                Html.th cellAttrs kids

            else
                Html.td cellAttrs kids

        Text _ ->
            Html.span (attrs node "t") (Array.flatten [ own, kids ])

        Emphasis ->
            Html.em (attrs node "") kids

        Strong ->
            Html.strong (attrs node "") kids

        Strikethrough ->
            Html.node "del" (attrs node "") kids

        CodeSpan _ ->
            Html.code (attrs node "") own

        Link link ->
            Html.a
                (Array.pushLast (Attr.href link.url) (attrs node ""))
                kids

        Image image ->
            Html.img
                (Array.flatten
                    [ attrs node ""
                    , [ Attr.src image.url, Attr.alt image.alt, Attr.title image.title ]
                    ]
                )
                []

        LineBreak ->
            -- The space this stands for is counted but not drawn, so a
            -- highlight crossing a wrap picks up again on the next line.
            Html.br [] []

        RawHtml _ ->
            Html.code (attrs node "raw-html") own


{-| Pair each rendered child with the id of the node it came from, for the two
containers that key their children. `viewChildren` walks `Doc.children` in order
and appends in that order, so the two arrays line up. Doing this here, rather
than in the walk, keeps every other element from paying for keys it never uses.
-}
keyed : Node -> Array (Html Msg) -> Array { key : String, node : Html Msg }
keyed node kids =
    Array.map2
        (\child html -> { key = Doc.id child, node = html })
        (Doc.children node)
        kids


{-| Every rendered element carries its node id, source span and source line.
The selection handler in JS reads the first two to build an anchor; the line is
drawn in the margin by CSS, which keeps it out of the DOM text the anchor is cut
from — a number rendered as an element would end up inside quoted passages.
-}
attrs : Node -> String -> Array (Html.Attribute Msg)
attrs node extraClass =
    let
        nodeSpan =
            Doc.span node

        sourceLine =
            Doc.line node
    in
    Array.flatten
        [ [ Attr.attribute "data-node-id" (Doc.id node)
          , Attr.attribute "data-span-start" (String.fromInt nodeSpan.start)
          , Attr.attribute "data-span-end" (String.fromInt nodeSpan.end)
          , Attr.class extraClass
          ]
        , if sourceLine > 0 then
            [ Attr.attribute "data-line" (String.fromInt sourceLine) ]

          else
            []
        ]


orderedAttrs : Node -> Int -> Array (Html.Attribute Msg)
orderedAttrs node start =
    if start > 0 then
        Array.pushLast (Attr.start start) (attrs node "")

    else
        attrs node ""


headingTag : Int -> Array (Html.Attribute Msg) -> Array (Html Msg) -> Html Msg
headingTag level =
    when level is
        1 ->
            Html.h1

        2 ->
            Html.h2

        3 ->
            Html.h3

        4 ->
            Html.h4

        5 ->
            Html.h5

        _ ->
            Html.h6


viewCheckbox : Bool -> Html Msg
viewCheckbox isChecked =
    Html.input
        [ Attr.type_ "checkbox"
        , Attr.checked isChecked
        , Attr.disabled True
        ]
        []


alignStyle : Align -> Html.Attribute Msg
alignStyle align =
    when align is
        AlignLeft ->
            Attr.style "text-align" "left"

        AlignRight ->
            Attr.style "text-align" "right"

        AlignCenter ->
            Attr.style "text-align" "center"

        AlignDefault ->
            Attr.style "" ""


{-| Render one leaf's text, marked where a commented or changed passage covers
it, and report where the walk has reached.
-}
markUp : Marking -> Int -> String -> { html : Array (Html Msg), next : Int }
markUp over base text =
    { html = Array.map (viewPiece over.marks) (Marks.split over.marks over.changes base text)
    , next = base + String.count text
    }


{-| One piece of a leaf's text, under whichever of the two highlights cover it.

A commented passage stays the one that can be clicked, and keeps its colour when
it has also changed: the change is shown under it as a line instead, so a
sentence that is both does not have to choose which it is.

-}
viewPiece : Array Range -> Marks.Piece -> Html Msg
viewPiece marks piece =
    when piece.thread is
        Just threadId ->
            let
                -- The thread's quote points back here, and a passage broken
                -- across a link or a soft wrap is several marks. The id goes on
                -- the one the passage starts at, which is the place to arrive.
                named =
                    if Array.any (\range -> range.thread == threadId && range.start == piece.start) marks then
                        [ Attr.id (markElementId threadId) ]

                    else
                        []
            in
            Html.node "mark"
                (Array.append
                    [ Attr.class
                        (if piece.changed then
                            "anchored changed"

                         else
                            "anchored"
                        )
                    , Attr.title "Go to this thread"
                    , Events.onClick (FocusThread threadId)
                    ]
                    named
                )
                [ Html.text piece.text ]

        Nothing ->
            if piece.changed then
                Html.node "mark"
                    [ Attr.class "changed"
                    , Attr.title "Changed since this session began"
                    ]
                    [ Html.text piece.text ]

            else
                Html.text piece.text


{-| Where each unresolved thread's quote sits in the document's text, and which
thread each one is. A resolved thread is not marked, so a highlight always leads
somewhere still open -- which is the point of following one.
-}
needleFor : Anchor -> Marks.Needle
needleFor anchor =
    { quote = anchor.quote, prefix = anchor.prefix, suffix = anchor.suffix }


{-| The threads of a document in the order their passages appear in it.

Filed order is when the reviewer happened to ask; for a pass it is an artefact
of the order the model wrote its answer in, which is nothing the reader can see.
Document order is the order the page beside the column is read in.

A thread whose passage is gone has no place in the document to sort by, and goes
to the bottom -- which is where an outdated thread belongs anyway. Among equals
the order they were filed in is kept, so the column does not reshuffle itself
every time a thread is re-anchored.

-}
inDocumentOrder : Array Range -> Array Thread -> Array Thread
inDocumentOrder found threads =
    let
        placed =
            Array.indexedMap (\index range -> { index = index, thread = range.thread }) found
                |> Array.foldl (\entry acc -> Dict.set entry.thread entry.index acc) Dict.empty

        rank thread =
            Maybe.withDefault (Array.length found) (Dict.get thread.id placed)
    in
    threads
        |> Array.indexedMap (\index thread -> { filed = index, thread = thread })
        |> Array.sortWith
            (\a b ->
                when compare (rank a.thread) (rank b.thread) is
                    EQ ->
                        compare a.filed b.filed

                    other ->
                        other
            )
        |> Array.map .thread


marksIn : Array Char -> Array Thread -> Array Range
marksIn plain threads =
    threads
        |> Array.keepIf (\thread -> thread.status /= Resolved)
        |> Array.mapAndKeepJust
            (\thread ->
                Marks.find plain (needleFor thread.anchor)
                    |> Maybe.map
                        (\at -> { start = at.start, end = at.end, thread = thread.id })
            )
        |> Array.sortBy .start


-- SIDEBAR


viewSidebar : Model -> Html Msg
viewSidebar model =
    let
        shown =
            if model.showResolved then
                model.threads

            else
                Array.keepIf (\thread -> thread.status /= Resolved) model.threads
    in
    Html.aside
        [ Attr.class "threads", Attr.id threadsPaneId ]
        (if Array.isEmpty shown then
            [ Html.p
                [ Attr.class "empty" ]
                [ Html.text
                    -- An empty column and a column emptied by the toggle are
                    -- not the same thing, and the reviewer who put the threads
                    -- away five minutes ago should not have to remember that.
                    (if Array.isEmpty model.threads then
                        "Select text in the document to comment."

                     else
                        "Every thread here is resolved, and resolved threads are hidden."
                    )
                ]
            ]

         else
            Array.map (viewThread model.marks model.replyDrafts) shown
        )


viewThread : Array Range -> Dict String String -> Thread -> Html Msg
viewThread marks drafts thread =
    Html.section
        [ Attr.class (String.join " " [ "thread", statusClass thread.status, originClass thread ])
        , Attr.id (threadElementId thread.id)
        , Attr.attribute "data-thread-id" thread.id
        ]
        [ viewRaisedBy thread
        , viewQuote (Array.any (\range -> range.thread == thread.id) marks) thread
        , Html.div [ Attr.class "messages" ] (Array.map viewMessage thread.messages)
        , viewCommitLink thread.commit
        , viewThreadActions drafts thread
        ]


{-| The passage a thread is about, and the way back to it.

A comment the reviewer wrote themselves they can place from the words alone --
they selected them a minute ago. One a review raised quotes a passage they have
never seen, in a document long enough that reading it to find the sentence is
the work the comment was supposed to save. So the quote is the button: clicking
it takes the document to the words.

Only while there are words to take it to. A passage edited away is still worth
showing -- it is what the conversation was about -- but there is nothing to
point at, and a button that does nothing is worse than a quotation.

-}
viewQuote : Bool -> Thread -> Html Msg
viewQuote anchored thread =
    if anchored then
        Html.button
            [ Attr.class "quote"
            , Attr.title "Show this passage in the document"
            , Events.onClick (FocusPassage thread.id)
            ]
            [ Html.text thread.anchor.quote ]

    else
        Html.blockquote [ Attr.class "quote" ] [ Html.text thread.anchor.quote ]


{-| A thread the reviewer did not open says so, and says what it was asked to
look for.

The brief is the answer to "why is this comment here?", which is a question a
reviewer asks three passes later and cannot otherwise answer. It is one string
recording what was asked, not a classification of what the model meant.

-}
viewRaisedBy : Thread -> Html Msg
viewRaisedBy thread =
    if thread.origin /= Model then
        Html.text ""

    else
        Html.div
            [ Attr.class "raised"
            , Attr.title
                (if String.isEmpty thread.brief then
                    "Raised by a review of this document"

                 else
                    "Raised by a review looking for: " ++ thread.brief
                )
            ]
            [ Html.text "raised by review" ]


{-| `awaits` is the whole of what a machine comment adds to the lifecycle: the
model has spoken and is waiting on a person, where a reviewer's own thread is
the other way round. It is read off who spoke last rather than stored, which is
why there are still four statuses.
-}
originClass : Thread -> String
originClass thread =
    let
        awaits =
            thread.status == Open && lastSpeaker thread == Just Assistant
    in
    when thread.origin is
        Model ->
            if awaits then
                "raised-by-model awaits"

            else
                "raised-by-model"

        Reviewer ->
            "raised-by-reviewer"


lastSpeaker : Thread -> Maybe Role
lastSpeaker thread =
    Array.last thread.messages |> Maybe.map .role


viewMessage : Protocol.Message -> Html Msg
viewMessage message =
    Html.div
        [ Attr.class
            (when message.role is
                User ->
                    "msg user"

                Assistant ->
                    "msg assistant"
            )
        ]
        [ Html.text message.text ]


viewCommitLink : String -> Html Msg
viewCommitLink commit =
    if String.isEmpty commit then
        Html.text ""

    else
        Html.div
            [ Attr.class "commit" ]
            [ Html.text ("committed " ++ String.takeFirst 8 commit) ]


viewThreadActions : Dict String String -> Thread -> Html Msg
viewThreadActions drafts thread =
    when thread.status is
        Thinking ->
            -- The dots are one string with the tail clipped by a CSS animation,
            -- rather than five elements appearing in turn: the width is then
            -- fixed and the thread does not twitch while the model thinks.
            Html.div
                [ Attr.class "pending", Attr.attribute "aria-label" "waiting for the model" ]
                [ Html.span [ Attr.class "dots" ] [ Html.text "....." ] ]

        Resolved ->
            Html.div [ Attr.class "resolved" ] [ Html.text "resolved" ]

        _ ->
            Html.div
                [ Attr.class "actions" ]
                [ Html.textarea
                    [ Attr.class "reply"
                    , Attr.placeholder "Reply…"
                    , Attr.value (Maybe.withDefault "" (Dict.get thread.id drafts))
                    , Events.onInput
                        (\text -> ReplyChanged { threadId = thread.id, text = text })
                    , composerKeys { submit = SubmitReply thread.id, cancel = Nothing }
                    ]
                    []
                , Html.button
                    [ Events.onClick (SubmitReply thread.id) ]
                    [ Html.text "Send" ]
                , Html.button
                    [ Attr.class "secondary", Events.onClick (ResolveThread thread.id) ]
                    [ Html.text "Resolve" ]
                ]


statusClass : ThreadStatus -> String
statusClass status =
    when status is
        Open ->
            "open"

        Thinking ->
            "thinking"

        Resolved ->
            "resolved"

        Outdated ->
            "outdated"


-- COMPOSER


viewComposer : Maybe Composing -> Html Msg
viewComposer composing =
    when composing is
        Nothing ->
            Html.text ""

        Just active ->
            Html.div
                [ Attr.class "composer" ]
                [ Html.blockquote
                    [ Attr.class "quote" ]
                    [ Html.text active.anchor.quote ]
                , if active.stale then
                    Html.p
                        [ Attr.class "stale" ]
                        [ Html.text "This passage has changed since you selected it." ]

                  else
                    Html.text ""
                , when active.edit is
                    Just editing ->
                        viewEditor editing

                    Nothing ->
                        viewCommentForm active
                ]


viewCommentForm : Composing -> Html Msg
viewCommentForm active =
    Html.div
        [ Attr.class "form" ]
        [ Html.textarea
            [ Attr.placeholder "reword this / why this? / …"
            , Attr.value active.draft
            , Attr.autofocus True
            , Events.onInput DraftChanged
            , composerKeys { submit = SubmitComment, cancel = Just CancelComment }
            ]
            []
        , Html.div
            [ Attr.class "composer-actions" ]
            [ Html.button
                [ Events.onClick SubmitComment
                , Attr.disabled (active.sent /= Nothing)
                ]
                [ Html.text
                    (if active.sent /= Nothing then
                        "Sending…"

                     else
                        "Comment"
                    )
                ]
            , Html.button
                [ Attr.class "secondary", Events.onClick StartEdit ]
                [ Html.text "Edit it myself" ]
            , Html.button
                [ Attr.class "secondary", Events.onClick CancelComment ]
                [ Html.text "Cancel" ]
            ]
        ]


{-| The passage as Markdown, for the reviewer to change by hand.

What is in the box is the source, not the rendered words: an asterisk the
renderer ate is still an asterisk in the file, and editing the rendered text
would quietly drop every one of them.

-}
viewEditor : Editing -> Html Msg
viewEditor editing =
    if not editing.ready then
        Html.div
            [ Attr.class "form" ]
            [ Html.p
                [ Attr.class "note" ]
                [ Html.text "Fetching the Markdown behind this passage…" ]
            , Html.div
                [ Attr.class "composer-actions" ]
                [ Html.button
                    [ Attr.class "secondary", Events.onClick CancelEdit ]
                    [ Html.text "Cancel" ]
                ]
            ]

    else
        Html.div
            [ Attr.class "form" ]
            [ Html.p
                [ Attr.class "note" ]
                [ Html.text "Markdown source. Saving commits it; no model turn runs." ]
            , Html.textarea
                [ Attr.class "source"
                , Attr.id editSourceId
                , Attr.rows 5
                , Attr.spellcheck False
                , Attr.value editing.draft
                , Attr.autofocus True
                , Events.onInput EditChanged
                , composerKeys { submit = SubmitEdit, cancel = Just CancelEdit }
                ]
                []
            , Html.div
                [ Attr.class "composer-actions" ]
                [ Html.button
                    [ Events.onClick SubmitEdit, Attr.disabled editing.sent ]
                    [ Html.text
                        (if editing.sent then
                            "Saving…"

                         else
                            "Save"
                        )
                    ]
                , Html.button
                    [ Attr.class "secondary icon"
                    , Attr.title "Empty the box; nothing is saved until you press Save"
                    , Events.onClick ClearEdit
                    , Attr.disabled (editing.sent || String.isEmpty editing.draft)
                    ]
                    [ trashIcon, Html.text "Clear" ]
                , Html.button
                    [ Attr.class "secondary", Events.onClick CancelEdit ]
                    [ Html.text "Cancel" ]
                ]
            ]


{-| A bin, drawn rather than written: an emoji would arrive in whatever colour
and weight the platform felt like, and this one is a stroke of the button's own
text colour, so it dims with the label when the button is disabled.
-}
trashIcon : Html Msg
trashIcon =
    Svg.svg
        [ SvgAttr.viewBox "0 0 16 16"
        , SvgAttr.width "13"
        , SvgAttr.height "13"
        , SvgAttr.fill "none"
        , SvgAttr.stroke "currentColor"
        , SvgAttr.strokeWidth "1.3"
        , SvgAttr.strokeLinecap "round"
        , SvgAttr.strokeLinejoin "round"
        ]
        [ Svg.path [ SvgAttr.d "M2.5 4.5h11" ] []
        , Svg.path [ SvgAttr.d "M6 4.5V3h4v1.5" ] []
        , Svg.path [ SvgAttr.d "M4 4.5v8.5h8V4.5" ] []
        , Svg.path [ SvgAttr.d "M6.5 7v3.5M9.5 7v3.5" ] []
        ]


{-| The two keys a box of typed words answers to: Shift-Enter sends it, Escape
abandons it.

Both live here rather than in the selection handler in JS, which used to catch
Escape by watching every keyup: that handler could not tell Escape from any
other key pressed with Shift, so typing a "?" into this box looked like a new
selection and threw the draft away.

Shift-Enter has to preventDefault. Without it the browser puts a newline in the
box on its way to the send, which is invisible while the box is about to close
and very visible when the server refuses the frame and the words come back with
a blank line grown on the end.

-}
composerKeys : { submit : Msg, cancel : Maybe Msg } -> Html.Attribute Msg
composerKeys keys =
    Events.preventDefaultOn "keydown"
        (Decode.map2
            (\key shift -> { key = key, shift = shift })
            (Decode.field "key" Decode.string)
            (Decode.field "shiftKey" Decode.bool)
            |> Decode.andThen (keyAction keys)
        )


keyAction :
    { submit : Msg, cancel : Maybe Msg }
    -> { key : String, shift : Bool }
    -> Decode.Decoder { message : Msg, preventDefault : Bool }
keyAction keys event =
    if event.key == "Enter" && event.shift then
        Decode.succeed { message = keys.submit, preventDefault = True }

    else
        when { key = event.key, cancel = keys.cancel } is
            { key = "Escape", cancel = Just msg } ->
                Decode.succeed { message = msg, preventDefault = False }

            _ ->
                Decode.fail "not a composer key"


-- MAIN


main : Program { theme : String, showChanges : Bool, showResolved : Bool } Model Msg
main =
    Browser.element
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
