port module Main exposing (main)

{-| The review UI.

The client renders a tree the server parsed and holds no Markdown of its own.
Everything durable — documents, threads, transcripts, commits — lives on the
server; a reload rebuilds this model from one `doc` and one `threads` message.

-}

import Array exposing (Array)
import Browser
import Browser.Dom as Dom
import Dict exposing (Dict)
import Doc exposing (Align(..), Doc, Kind(..), Node)
import Html exposing (Html)
import Html.Attributes as Attr
import Html.Events as Events
import Html.Keyed
import Json.Decode as Decode
import Json.Encode as Encode
import Marks exposing (Range)
import Math
import Protocol exposing (Anchor, Role(..), ServerMsg(..), Thread, ThreadStatus(..))
import Task


-- PORTS
--
-- Four, and only four. Everything else the app needs is expressible in Gren.


{-| Outbound protocol frames. The JS side stringifies and writes to the socket.
-}
port socketOut : Encode.Value -> Cmd msg


{-| Inbound protocol frames, already parsed from JSON by the JS side.
-}
port socketIn : (Decode.Value -> msg) -> Sub msg


{-| Connection lifecycle: "open", "closed", or "connecting".
-}
port socketState : (String -> msg) -> Sub msg


{-| A completed text selection inside the document pane.

The JS side does the DOM work — walking up to the nearest `[data-node-id]`,
reading the surrounding characters for the anchor — and hands over a finished
anchor. Sending text rather than DOM offsets means the payload stays valid even
if a re-render lands while the reviewer is still typing their comment.

-}
port selectionIn : (Decode.Value -> msg) -> Sub msg


{-| Drop the browser selection once a comment has been filed.
-}
port clearSelection : {} -> Cmd msg


{-| The reviewer's choice of theme: "auto", "light" or "dark".

A Gren program owns the element it is mounted into and nothing above it, and the
whole switch is one `color-scheme` on `<html>`. The JS side also remembers the
choice, so the page it draws on the next visit is the one that was left.

-}
port setTheme : String -> Cmd msg


-- MODEL


type alias Model =
    { theme : String
    , docs : Array String
    , opened : String
    , current : Maybe Doc
    , threads : Array Thread
    , busy : Bool
    , composing : Maybe Composing
    , marks : Array Range
    , replyDrafts : Dict String String
    , connection : String
    , settings : Maybe Protocol.Settings
    , settingsOpen : Bool
    , error : Maybe String
    }


{-| A comment being written.

Typed words are the one thing in this app the server cannot give back, so the
composer is only ever closed by the reviewer or by the arrival of the filed
comment itself. Neither a re-render nor a rejected submission discards it.

`sent` holds the exact text handed to the server while it is unconfirmed, so the
thread list can be matched against it; `stale` records that the passage was
edited away underneath the draft.

-}
type alias Composing =
    { anchor : Anchor
    , draft : String
    , sent : Maybe String
    , stale : Bool
    , edit : Maybe Editing
    }


{-| A passage the reviewer is rewriting themselves.

Not every comment is a question. When the reviewer already has the words they
want, a turn spent having the model type them back is slower and paid for by the
token, so the passage is handed over as Markdown and written straight to the
file.

`source` is what the server found behind the selection — the browser renders a
tree it never sees the syntax of, so the words on screen are not what is in the
file. It is also the compare-and-swap: the server writes the replacement only
while the passage still reads exactly this way.

-}
type alias Editing =
    { source : String
    , draft : String
    , ready : Bool
    , sent : Bool
    }


{-| The theme comes in as a flag because the page has already been drawn in it:
the script in index.html applies the saved choice before the first paint, and
this is the app being told what that was rather than deciding it again.
-}
init : { theme : String } -> { model : Model, command : Cmd Msg }
init flags =
    { model =
        { theme = flags.theme
        , docs = []
        , opened = ""
        , current = Nothing
        , threads = []
        , busy = False
        , composing = Nothing
        , marks = []
        , replyDrafts = Dict.empty
        , connection = "connecting"
        , settings = Nothing
        , settingsOpen = False
        , error = Nothing
        }
    , command = Cmd.none
    }


-- UPDATE


type Msg
    = ServerFrame Decode.Value
    | SelectionMade Decode.Value
    | ConnectionState String
    | OpenDoc String
    | DraftChanged String
    | SubmitComment
    | CancelComment
    | StartEdit
    | EditChanged String
    | SubmitEdit
    | CancelEdit
    | ReplyChanged { threadId : String, text : String }
    | SubmitReply String
    | ResolveThread String
    | InterruptTurn
    | ToggleSettings
    | ModelPicked String
    | ClearContext
    | ThemePicked String
    | FocusThread String
    | ThreadScrolled
    | DismissError


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        ServerFrame raw ->
            when Decode.decodeValue Protocol.serverMsgDecoder raw is
                Ok frame ->
                    applyServerMsg frame model

                Err err ->
                    stay { model | error = Just (Decode.errorToString err) }

        SelectionMade raw ->
            when Decode.decodeValue anchorDecoder raw is
                Ok anchor ->
                    if String.isEmpty (String.trim anchor.quote) then
                        -- A cleared selection — usually a stray click in the
                        -- document — closes an untouched composer but never one
                        -- with words in it. Those go away by Cancel or Escape,
                        -- which are deliberate.
                        stay { model | composing = keepIfWritten model.composing }

                    else
                        stay
                            { model
                                | composing =
                                    Just
                                        { anchor = anchor
                                        , draft = ""
                                        , sent = Nothing
                                        , stale = False
                                        , edit = Nothing
                                        }
                            }

                Err _ ->
                    stay { model | composing = keepIfWritten model.composing }

        ConnectionState state ->
            stay { model | connection = state }

        OpenDoc path ->
            { model = { model | composing = Nothing, opened = path }
            , command = socketOut (Protocol.openDoc path)
            }

        DraftChanged text ->
            when model.composing is
                Just composing ->
                    stay { model | composing = Just { composing | draft = text } }

                Nothing ->
                    stay model

        SubmitComment ->
            when { composing = model.composing, doc = model.current } is
                { composing = Just composing, doc = Just doc } ->
                    -- The composer stays on screen, holding the text, until a
                    -- thread carrying this comment comes back. A comment the
                    -- server refuses — its passage edited away while the
                    -- reviewer typed — then leaves the words where they are
                    -- instead of behind an error banner.
                    if String.isEmpty (String.trim composing.draft) || composing.sent /= Nothing then
                        stay model

                    else
                        { model = { model | composing = Just { composing | sent = Just composing.draft } }
                        , command =
                            Cmd.batch
                                [ socketOut
                                    (Protocol.comment
                                        { doc = doc.path
                                        , anchor = composing.anchor
                                        , body = composing.draft
                                        }
                                    )
                                , clearSelection {}
                                ]
                        }

                _ ->
                    stay model

        CancelComment ->
            { model = { model | composing = Nothing }, command = clearSelection {} }

        StartEdit ->
            when { composing = model.composing, doc = model.current } is
                { composing = Just composing, doc = Just doc } ->
                    { model =
                        { model
                            | composing =
                                Just
                                    { composing
                                        | edit =
                                            Just
                                                { source = ""
                                                , draft = ""
                                                , ready = False
                                                , sent = False
                                                }
                                    }
                        }
                    , command =
                        socketOut
                            (Protocol.editSource { doc = doc.path, anchor = composing.anchor })
                    }

                _ ->
                    stay model

        EditChanged text ->
            stay
                { model | composing = mapEdit (\editing -> { editing | draft = text }) model.composing }

        SubmitEdit ->
            when { composing = model.composing, doc = model.current } is
                { composing = Just composing, doc = Just doc } ->
                    when composing.edit is
                        Just editing ->
                            -- Sending before the source has arrived would ask
                            -- the server to swap the passage for nothing.
                            if not editing.ready || editing.sent then
                                stay model

                            else
                                { model = { model | composing = Just { composing | edit = Just { editing | sent = True } } }
                                , command =
                                    socketOut
                                        (Protocol.applyEdit
                                            { doc = doc.path
                                            , anchor = composing.anchor
                                            , original = editing.source
                                            , replacement = editing.draft
                                            }
                                        )
                                }

                        Nothing ->
                            stay model

                _ ->
                    stay model

        CancelEdit ->
            -- Back to the comment, which still has whatever was typed into it.
            stay
                { model | composing = Maybe.map (\composing -> { composing | edit = Nothing }) model.composing }

        ReplyChanged change ->
            stay
                { model | replyDrafts = Dict.set change.threadId change.text model.replyDrafts }

        SubmitReply threadId ->
            let
                draft =
                    Dict.get threadId model.replyDrafts
                        |> Maybe.withDefault ""
            in
            if String.isEmpty (String.trim draft) then
                stay model

            else
                { model = { model | replyDrafts = Dict.remove threadId model.replyDrafts }
                , command = socketOut (Protocol.reply { threadId = threadId, body = draft })
                }

        ResolveThread threadId ->
            { model = model, command = socketOut (Protocol.resolve threadId) }

        InterruptTurn ->
            when model.current is
                Just doc ->
                    { model = model, command = socketOut (Protocol.interrupt doc.path) }

                Nothing ->
                    stay model

        ToggleSettings ->
            stay { model | settingsOpen = not model.settingsOpen }

        ModelPicked name ->
            -- The panel keeps showing the old model until the daemon confirms
            -- the change in a settings frame: what Claude is actually running
            -- is the server's answer to give, not the select element's.
            { model = model, command = socketOut (Protocol.setModel name) }

        ClearContext ->
            { model = model, command = socketOut Protocol.clearContext }

        ThemePicked theme ->
            { model = { model | theme = theme }, command = setTheme theme }

        FocusThread threadId ->
            -- The reviewer pointed at a highlighted passage, which is how you
            -- ask for the conversation about it.
            { model = model, command = showEndOfThread threadId }

        ThreadScrolled ->
            -- Nothing to do; the scroll either happened or the thread was gone.
            stay model

        DismissError ->
            stay { model | error = Nothing }


stay : Model -> { model : Model, command : Cmd Msg }
stay model =
    { model = model, command = Cmd.none }


applyServerMsg : ServerMsg -> Model -> { model : Model, command : Cmd Msg }
applyServerMsg frame model =
    when frame is
        DocUpdated doc ->
            -- Renders are broadcast, and the daemon re-renders whatever changed
            -- on disk — a document nobody has open, a whole branch's worth
            -- during a checkout. Only the one that was asked for is drawn;
            -- without that test the page moves off what the reviewer is reading
            -- whenever some other file is touched.
            --
            -- An anchor is text rather than offsets, so an edit elsewhere in
            -- the document leaves it perfectly valid and a re-render is no
            -- reason to throw a draft away. When the passage itself has gone,
            -- the composer says so and still keeps the words.
            if doc.path == model.opened then
                stay (afterDocChange doc model)

            else
                stay model

        ThreadsUpdated payload ->
            { model =
                { model
                    | threads = payload.threads
                    , marks = marksIn (plainTextOf model.current) payload.threads
                    , composing = closeIfFiled payload.threads model.composing
                }
            , command =
                -- The comment just filed is at the end of a column that may be
                -- taller than the window, so it arrives off screen.
                when justFiled payload.threads model.composing is
                    Just threadId ->
                        showEndOfThread threadId

                    Nothing ->
                        Cmd.none
            }

        AssistantDelta payload ->
            stay { model | threads = appendDelta payload.threadId payload.text model.threads }

        TurnEnded payload ->
            -- The answer has landed and the reply box has appeared under it.
            -- Both are at the end of a thread that is often taller than the
            -- pane, so the pane goes to where the new words are.
            { model =
                { model
                    | threads =
                        mapThread payload.threadId
                            (\thread -> { thread | status = Open, commit = payload.commit })
                            model.threads
                }
            , command = showEndOfThread payload.threadId
            }

        BusyChanged payload ->
            stay { model | busy = payload.busy }

        DocList docs ->
            stay { model | docs = docs }

        SettingsUpdated settings ->
            stay { model | settings = Just settings }

        EditSource payload ->
            stay { model | composing = fillSource payload (docPathOf model) model.composing }

        EditApplied payload ->
            -- The edit is in the file and committed; the editor has nothing
            -- left to hold on to.
            if waitingOnEdit payload (docPathOf model) model.composing then
                { model = { model | composing = Nothing }, command = clearSelection {} }

            else
                stay model

        ServerError message ->
            -- Whatever went wrong, nothing was filed: take what was in flight
            -- out of it so the reviewer can edit and send it again.
            stay
                { model
                    | error = Just message
                    , composing = Maybe.map afterFailure model.composing
                }


{-| Put a composer back the way it was before it sent anything.

The words are kept — they are the one thing the server cannot give back — but an
editor still waiting for its source has nothing to show and no way to be
dismissed, so it steps aside and leaves the comment behind it.

-}
afterFailure : Composing -> Composing
afterFailure composing =
    { composing
        | sent = Nothing
        , edit = Maybe.andThen unsend composing.edit
    }


unsend : Editing -> Maybe Editing
unsend editing =
    if editing.ready then
        Just { editing | sent = False }

    else
        Nothing


keepIfWritten : Maybe Composing -> Maybe Composing
keepIfWritten composing =
    when composing is
        Just active ->
            if active.edit == Nothing && String.isEmpty (String.trim active.draft) then
                Nothing

            else
                composing

        Nothing ->
            Nothing


mapEdit : (Editing -> Editing) -> Maybe Composing -> Maybe Composing
mapEdit fn composing =
    Maybe.map (\active -> { active | edit = Maybe.map fn active.edit }) composing


docPathOf : Model -> String
docPathOf model =
    when model.current is
        Just doc ->
            doc.path

        Nothing ->
            ""


{-| Take the source the server sent, if this composer is the one that asked.

Every frame goes to every connection, so a source arriving for a passage this
tab is not editing is ordinary and ignored — as is a second copy of one already
being edited, which would otherwise throw away what has been typed since.

-}
fillSource :
    { doc : String, quote : String, text : String }
    -> String
    -> Maybe Composing
    -> Maybe Composing
fillSource payload docPath composing =
    when composing is
        Just active ->
            when active.edit is
                Just editing ->
                    if editing.ready || payload.doc /= docPath || active.anchor.quote /= payload.quote then
                        composing

                    else
                        Just
                            { active
                                | edit =
                                    Just
                                        { editing
                                            | source = payload.text
                                            , draft = payload.text
                                            , ready = True
                                        }
                            }

                Nothing ->
                    composing

        Nothing ->
            composing


{-| Whether this tab is the one holding the edit that just landed.
-}
waitingOnEdit :
    { doc : String, quote : String, commit : String }
    -> String
    -> Maybe Composing
    -> Bool
waitingOnEdit payload docPath composing =
    when composing is
        Just active ->
            when active.edit is
                Just editing ->
                    editing.sent
                        && payload.doc == docPath
                        && active.anchor.quote == payload.quote

                Nothing ->
                    False

        Nothing ->
            False


{-| Fold a new render of the document into the model.

The document's plain text is searched here and nowhere else: once to place every
thread's quote, once to tell a draft whether the passage it was written against
is still there. Both answers are kept in the model, so drawing a frame never
searches the document again.

-}
afterDocChange : Doc -> Model -> Model
afterDocChange doc model =
    let
        plain =
            Marks.plainText (Doc.text doc.root)
    in
    { model
        | current = Just doc
        , marks = marksIn plain model.threads
        , composing =
            Maybe.map
                (\composing ->
                    { composing | stale = Marks.find plain composing.anchor.quote == Nothing }
                )
                model.composing
    }


plainTextOf : Maybe Doc -> Array Char
plainTextOf current =
    when current is
        Just doc ->
            Marks.plainText (Doc.text doc.root)

        Nothing ->
            []


{-| Close the composer once the comment it sent has come back as a thread.

Matching on the text rather than acknowledging the request keeps the client from
needing request ids: the server broadcasts the thread list as soon as it accepts
a comment, and a rejected one never appears there.

-}
closeIfFiled : Array Thread -> Maybe Composing -> Maybe Composing
closeIfFiled threads composing =
    when composing is
        Just active ->
            when active.sent is
                Just sent ->
                    if Array.any (carries active.anchor.quote sent) threads then
                        Nothing

                    else
                        composing

                Nothing ->
                    composing

        Nothing ->
            Nothing


{-| The id of the thread carrying the comment this tab has in flight, if it has
just come back.
-}
justFiled : Array Thread -> Maybe Composing -> Maybe String
justFiled threads composing =
    when composing is
        Just active ->
            when active.sent is
                Just sent ->
                    Array.findFirst (carries active.anchor.quote sent) threads
                        |> Maybe.map (\found -> found.value.id)

                Nothing ->
                    Nothing

        Nothing ->
            Nothing


{-| Scroll the threads pane so the end of one thread is at the bottom of it.

The end is what matters rather than the start: a long exchange does not fit, and
what the reviewer is waiting for is the newest answer and the empty reply box
under it. Browser.Dom reads the DOM inside an animation frame, which is after
the frame this update is drawn in, so the measurements are of the thread as it
now stands rather than as it was.

-}
showEndOfThread : String -> Cmd Msg
showEndOfThread threadId =
    Dom.getElement (threadElementId threadId)
        |> Task.andThen
            (\thread ->
                Dom.getElement threadsPaneId
                    |> Task.andThen
                        (\pane ->
                            Dom.getViewportOf threadsPaneId
                                |> Task.andThen
                                    (\pane_ ->
                                        let
                                            -- Where the thread ends, measured
                                            -- from the top of everything the
                                            -- pane can scroll through.
                                            ends =
                                                pane_.viewport.y
                                                    + (thread.element.y + thread.element.height)
                                                    - pane.element.y
                                        in
                                        Dom.setViewportOf threadsPaneId 0 (ends - pane_.viewport.height + 12)
                                    )
                        )
            )
        |> Task.attempt (\_ -> ThreadScrolled)


threadsPaneId : String
threadsPaneId =
    "threads"


threadElementId : String -> String
threadElementId threadId =
    "thread-" ++ threadId


carries : String -> String -> Thread -> Bool
carries quote body thread =
    thread.anchor.quote == quote
        && Array.any
            (\message -> message.role == User && message.text == body)
            thread.messages


{-| Streamed assistant text arrives in fragments; each one extends the thread's
trailing assistant message, or starts a new one if the reviewer spoke last.
-}
appendDelta : String -> String -> Array Thread -> Array Thread
appendDelta threadId text threads =
    mapThread threadId
        (\thread ->
            let
                lastIndex =
                    Array.length thread.messages - 1
            in
            when Array.get lastIndex thread.messages is
                Just last ->
                    if last.role == Assistant then
                        { thread
                            | messages =
                                Array.set lastIndex
                                    { last | text = last.text ++ text }
                                    thread.messages
                        }

                    else
                        { thread | messages = Array.pushLast { role = Assistant, text = text } thread.messages }

                Nothing ->
                    { thread | messages = Array.pushLast { role = Assistant, text = text } thread.messages }
        )
        threads


mapThread : String -> (Thread -> Thread) -> Array Thread -> Array Thread
mapThread threadId fn threads =
    Array.map
        (\thread ->
            if thread.id == threadId then
                fn thread

            else
                thread
        )
        threads


anchorDecoder : Decode.Decoder Anchor
anchorDecoder =
    Decode.map4
        (\nodeId quote prefix suffix ->
            { nodeId = nodeId, quote = quote, prefix = prefix, suffix = suffix }
        )
        (Decode.field "nodeId" Decode.string)
        (Decode.field "quote" Decode.string)
        (Decode.field "prefix" Decode.string)
        (Decode.field "suffix" Decode.string)


-- SUBSCRIPTIONS


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.batch
        [ socketIn ServerFrame
        , selectionIn SelectionMade
        , socketState ConnectionState
        ]


-- VIEW


view : Model -> Html Msg
view model =
    Html.div
        [ Attr.class "app" ]
        [ viewTopBar model
        , viewError model.error
        , Html.div
            [ Attr.class "body" ]
            [ viewDocument model
            , viewSidebar model
            ]
        , viewComposer model.composing
        ]


viewTopBar : Model -> Html Msg
viewTopBar model =
    Html.header
        [ Attr.class "topbar" ]
        [ Html.nav
            [ Attr.class "docs" ]
            (Array.map (viewDocTab model.current) model.docs)
        , Html.div
            [ Attr.class "state" ]
            [ if model.busy then
                Html.button
                    [ Attr.class "interrupt", Events.onClick InterruptTurn ]
                    [ Html.text "thinking — interrupt" ]

              else
                Html.text ""
            , viewSettingsButton model
            , viewConnection model.connection
            ]
        , viewSettingsPanel model
        ]


{-| The socket to the daemon, in one word.

"open" was the word the port uses, and on screen it read as something about the
document — a file being open, a thread being open. What it is about is whether
this page is still being told anything.

-}
viewConnection : String -> Html Msg
viewConnection state =
    let
        label =
            when state is
                "open" ->
                    "connected"

                "connecting" ->
                    "connecting…"

                _ ->
                    "disconnected"
    in
    Html.span
        [ Attr.class ("conn conn-" ++ state)
        , Attr.title "This page's connection to the review daemon"
        ]
        [ Html.text label ]


{-| The button names the model rather than saying "settings", because the model
is the setting anyone actually wants to check.
-}
viewSettingsButton : Model -> Html Msg
viewSettingsButton model =
    when model.settings is
        Nothing ->
            Html.text ""

        Just settings ->
            Html.button
                [ Attr.classList
                    [ { class = "settings-toggle", enabled = True }
                    , { class = "active", enabled = model.settingsOpen }
                    ]
                , Events.onClick ToggleSettings
                ]
                [ Html.text (modelLabel settings), Html.span [ Attr.class "caret" ] [ Html.text "▾" ] ]


{-| What to call the model in one word.

The configured name is what the reviewer chose, but it is empty by default --
the daemon asks for no model at all and lets the CLI decide -- so the resolved
name is what gets shown until there is a choice to report.

-}
modelLabel : Protocol.Settings -> String
modelLabel settings =
    if not (String.isEmpty settings.model) then
        settings.model

    else if not (String.isEmpty settings.runningModel) then
        shortModel settings.runningModel

    else
        "default model"


{-| "claude-sonnet-5" reads as "sonnet" in a toolbar. The full name is in the
panel, where there is room for it.
-}
shortModel : String -> String
shortModel name =
    when Array.findFirst (\family -> String.contains family name) [ "opus", "sonnet", "haiku", "fable" ] is
        Just found ->
            found.value

        Nothing ->
            name


viewSettingsPanel : Model -> Html Msg
viewSettingsPanel model =
    when { open = model.settingsOpen, settings = model.settings } is
        { open = True, settings = Just settings } ->
            Html.div
                [ Attr.class "settings" ]
                (Array.flatten
                    [ [ viewModelRow settings
                      , viewConversationRow settings (docPathOf model)
                      , viewThemeRow model.theme
                      ]
                    , viewSettingRows settings
                    ]
                )

        _ ->
            Html.text ""


viewModelRow : Protocol.Settings -> Html Msg
viewModelRow settings =
    Html.div
        [ Attr.class "setting model" ]
        [ Html.span [ Attr.class "label" ] [ Html.text "model" ]
        , Html.div
            [ Attr.class "value" ]
            [ Html.select
                [ Events.onInput ModelPicked ]
                (Array.map (viewModelChoice settings.model) settings.modelChoices)
            , if String.isEmpty settings.runningModel then
                Html.p
                    [ Attr.class "note" ]
                    [ Html.text "no turn has run yet" ]

              else
                Html.p
                    [ Attr.class "note" ]
                    [ Html.text ("running " ++ settings.runningModel) ]
            , Html.p
                [ Attr.class "note" ]
                [ Html.text "a change applies to the next comment; the conversation continues" ]
            , Html.button
                [ Attr.class "secondary clear-context"
                , Attr.title "Start the next comment on each document from a new conversation"
                , Events.onClick ClearContext
                ]
                [ Html.text "Clear context" ]
            , Html.p
                [ Attr.class "note" ]
                [ Html.text "forgets what has been said, everywhere; your comment threads stay" ]
            ]
        ]


viewModelChoice : String -> String -> Html Msg
viewModelChoice current name =
    Html.option
        [ Attr.value name, Attr.selected (name == current) ]
        [ Html.text
            (if String.isEmpty name then
                "default (your claude config)"

             else
                name
            )
        ]


{-| How much conversation the open document is carrying.

It sits under the button that throws it away, because that is the number the
decision turns on: a comment costs the whole conversation behind it, every turn,
and nothing else on screen says how big that has become.

-}
viewConversationRow : Protocol.Settings -> String -> Html Msg
viewConversationRow settings docPath =
    let
        here =
            Array.findFirst (\conversation -> conversation.doc == docPath) settings.conversations
                |> Maybe.map (\found -> found.value)
    in
    Html.div
        [ Attr.class "setting" ]
        [ Html.span [ Attr.class "label" ] [ Html.text "conversation" ]
        , Html.div
            [ Attr.class "value" ]
            (Array.flatten
                [ [ Html.div [] [ Html.text (conversationLabel here) ] ]
                , when elsewhere settings docPath is
                    Just note ->
                        [ Html.p [ Attr.class "note" ] [ Html.text note ] ]

                    Nothing ->
                        []
                ]
            )
        ]


conversationLabel : Maybe Protocol.Conversation -> String
conversationLabel here =
    when here is
        Just conversation ->
            turnCount conversation.turns ++ ", $" ++ money conversation.spentUsd

        Nothing ->
            "nothing said yet"


turnCount : Int -> String
turnCount turns =
    if turns == 1 then
        "1 turn"

    else
        String.fromInt turns ++ " turns"


{-| What the other documents are carrying, since Clear context takes them all.
-}
elsewhere : Protocol.Settings -> String -> Maybe String
elsewhere settings docPath =
    let
        others =
            Array.keepIf (\conversation -> conversation.doc /= docPath) settings.conversations

        turns =
            Array.foldl (\conversation total -> total + conversation.turns) 0 others

        spent =
            Array.foldl (\conversation total -> total + conversation.spentUsd) 0 others
    in
    if Array.isEmpty others then
        Nothing

    else
        Just
            ("and "
                ++ turnCount turns
                ++ ", $"
                ++ money spent
                ++ " on "
                ++ documentCount (Array.length others)
            )


documentCount : Int -> String
documentCount documents =
    if documents == 1 then
        "one other document"

    else
        String.fromInt documents ++ " other documents"


{-| Light, dark, or whatever the machine says.

The two things in this panel the reviewer can change are next to each other, and
this one is theirs rather than the review's: it is remembered in this browser,
not in the daemon, so two people reading the same review can disagree about it.

-}
viewThemeRow : String -> Html Msg
viewThemeRow theme =
    Html.div
        [ Attr.class "setting model" ]
        [ Html.span [ Attr.class "label" ] [ Html.text "theme" ]
        , Html.div
            [ Attr.class "value" ]
            [ Html.select
                [ Events.onInput ThemePicked ]
                (Array.map (viewThemeChoice theme)
                    [ { value = "auto", label = "auto (follow this machine)" }
                    , { value = "light", label = "light" }
                    , { value = "dark", label = "dark" }
                    ]
                )
            ]
        ]


viewThemeChoice : String -> { value : String, label : String } -> Html Msg
viewThemeChoice current choice =
    Html.option
        [ Attr.value choice.value, Attr.selected (choice.value == current) ]
        [ Html.text choice.label ]


viewSettingRows : Protocol.Settings -> Array (Html Msg)
viewSettingRows settings =
    Array.flatten
        [ [ setting "tools" (String.join ", " settings.tools)
          , setting "permissions" settings.permissionMode
          , setting "claude runs in" settings.workspace
          ]
        , if settings.reviewRoot == settings.workspace then
            []

          else
            [ setting "reviewing" settings.reviewRoot ]
        , if String.isEmpty settings.branch then
            []

          else
            [ viewBranch settings ]
        , [ setting "spent" (spendLabel settings)
          , setting "processes" (String.fromInt settings.live ++ " running")
          , setting "claude" (claudeLabel settings)
          ]
        ]


{-| The version, and the path only when it is not simply whatever is on PATH --
which is the answer to "is it even the claude I think it is?" without adding a
line that says "claude" to everybody else.
-}
claudeLabel : Protocol.Settings -> String
claudeLabel settings =
    let
        version =
            if String.isEmpty settings.cliVersion then
                "version unknown"

            else
                settings.cliVersion
    in
    if settings.cliPath == "claude" || String.isEmpty settings.cliPath then
        version

    else
        version ++ " — " ++ settings.cliPath


{-| The review's commits: where they are, how many, and how to land them.

The daemon does not merge. A merge can conflict, and a conflict raised inside a
page that has no diff and no way out is worse than no button at all -- so what
the panel offers is the command, ready to be read and run somewhere that can
answer it.

-}
viewBranch : Protocol.Settings -> Html Msg
viewBranch settings =
    Html.div
        [ Attr.class "setting" ]
        [ Html.span [ Attr.class "label" ] [ Html.text "branch" ]
        , Html.div
            [ Attr.class "value" ]
            (Array.flatten
                [ [ Html.div [] [ Html.text settings.branch ]
                  , Html.p [ Attr.class "note" ] [ Html.text (commitsLabel settings) ]
                  ]
                , if String.isEmpty settings.mergeCommand then
                    []

                  else
                    [ Html.pre
                        [ Attr.class "merge"
                        , Attr.title "Run this where git can answer a conflict"
                        ]
                        [ Html.text settings.mergeCommand ]
                    ]
                ]
            )
        ]


{-| How many commits are waiting, and where they are waiting to go.

The count is what the branch has that its base does not, so it says "nothing to
merge" the moment they have been merged -- including from a terminal, which the
daemon would otherwise never hear about.

-}
commitsLabel : Protocol.Settings -> String
commitsLabel settings =
    let
        counted =
            if settings.commits == 1 then
                "1 commit"

            else
                String.fromInt settings.commits ++ " commits"
    in
    if settings.commits == 0 then
        "nothing recorded yet"

    else if String.isEmpty settings.baseBranch then
        counted ++ " on it"

    else
        counted ++ " not yet in " ++ settings.baseBranch


setting : String -> String -> Html Msg
setting label value =
    Html.div
        [ Attr.class "setting" ]
        [ Html.span [ Attr.class "label" ] [ Html.text label ]
        , Html.span [ Attr.class "value" ] [ Html.text value ]
        ]


{-| Spend since this daemon started -- a resumed conversation from an earlier
run does not carry its cost forward, so the panel says what the number means.
-}
spendLabel : Protocol.Settings -> String
spendLabel settings =
    let
        spent =
            "$" ++ money settings.spentUsd ++ " this session"
    in
    if settings.maxBudgetUsd > 0 then
        spent ++ ", cap $" ++ money settings.maxBudgetUsd ++ " per process"

    else
        spent


money : Float -> String
money amount =
    let
        cents =
            Math.round (amount * 100)
    in
    String.fromInt (cents // 100)
        ++ "."
        ++ String.padLeft 2 '0' (String.fromInt (Math.modBy 100 cents))


viewDocTab : Maybe Doc -> String -> Html Msg
viewDocTab current path =
    let
        isCurrent =
            when current is
                Just doc ->
                    doc.path == path

                Nothing ->
                    False
    in
    Html.button
        [ Attr.classList
            [ { class = "doc-tab", enabled = True }
            , { class = "active", enabled = isCurrent }
            ]
        , Attr.title
            (if isCurrent then
                -- Clicking the open document re-reads it from disk. That is
                -- worth saying, because there is nothing about a tab that
                -- suggests the one already selected does anything at all.
                "Reload " ++ path ++ " from disk"

             else
                "Open " ++ path
            )
        , Events.onClick (OpenDoc path)
        ]
        [ Html.text path ]


viewError : Maybe String -> Html Msg
viewError maybeError =
    when maybeError is
        Just message ->
            Html.div
                [ Attr.class "error", Events.onClick DismissError ]
                [ Html.text message ]

        Nothing ->
            Html.text ""


viewDocument : Model -> Html Msg
viewDocument model =
    Html.main_
        [ Attr.class "doc", Attr.id "doc-pane" ]
        [ when model.current is
            Just doc ->
                .html (viewNode model.marks 0 doc.root)

            Nothing ->
                Html.p [ Attr.class "empty" ] [ Html.text "Select a document." ]
        ]


-- DOCUMENT RENDERING
--
-- The tree is walked once, carrying the offset the walk has reached in the
-- document's plain text -- the same text the quotes were located in. That
-- offset is what lets a highlight span nodes: each leaf splits itself wherever
-- a range begins or ends, and a range running past the leaf simply continues
-- into the next one.


{-| Render a node, and report where the walk has reached.
-}
viewNode : Array Range -> Int -> Node -> { html : Html Msg, next : Int }
viewNode marks offset node =
    let
        own =
            markUp marks offset (ownText node)

        kids =
            viewChildren marks own.next node
    in
    { html = element node own.html kids.html
    , next = kids.next
    }


viewChildren : Array Range -> Int -> Node -> { html : Array (Html Msg), next : Int }
viewChildren marks offset node =
    Array.foldl
        (\child acc ->
            let
                walked =
                    viewNode marks acc.next child
            in
            { html = Array.pushLast walked.html acc.html, next = walked.next }
        )
        { html = [], next = offset }
        (Doc.children node)


{-| The text a node contributes itself, before its children.

This has to agree with `Doc.text` exactly, down to the space a line break stands
for: the offsets counted here index the string the quotes were found in, so a
node that miscounts moves every highlight after it.

-}
ownText : Node -> String
ownText node =
    when Doc.kind node is
        Text raw ->
            raw

        CodeSpan raw ->
            raw

        CodeBlock code ->
            code.text

        HtmlBlock raw ->
            raw

        RawHtml raw ->
            raw

        LineBreak ->
            " "

        _ ->
            ""


{-| Assemble one element from its own text and its children, both already
rendered. Nothing here knows about offsets.
-}
element : Node -> Array (Html Msg) -> Array (Html Msg) -> Html Msg
element node own kids =
    when Doc.kind node is
        Document ->
            Html.Keyed.node "article" (attrs node "prose") (keyed node kids)

        Paragraph ->
            Html.p (attrs node "") kids

        Heading level ->
            headingTag level (attrs node "") kids

        CodeBlock code ->
            Html.pre
                (attrs node ("code lang-" ++ code.lang))
                [ Html.code [] own ]

        BlockQuote ->
            Html.blockquote (attrs node "") kids

        ListBlock list ->
            if list.ordered then
                Html.Keyed.ol (orderedAttrs node list.start) (keyed node kids)

            else
                Html.Keyed.ul (attrs node "") (keyed node kids)

        ListItem item ->
            when item.checked is
                Just isChecked ->
                    Html.li
                        (attrs node "task")
                        (Array.pushFirst (viewCheckbox isChecked) kids)

                Nothing ->
                    Html.li (attrs node "") kids

        ThematicBreak ->
            Html.hr (attrs node "") []

        HtmlBlock _ ->
            -- Raw HTML is shown as source, never injected. A document under
            -- review can contain anything, and rendering it would hand the page
            -- over to whatever the author wrote.
            Html.pre (attrs node "raw-html") own

        Table ->
            Html.table (attrs node "") kids

        TableRow row ->
            if row.header then
                Html.thead [] [ Html.tr (attrs node "") kids ]

            else
                Html.tbody [] [ Html.tr (attrs node "") kids ]

        TableCell cell ->
            let
                cellAttrs =
                    Array.pushLast (alignStyle cell.align) (attrs node "")
            in
            if cell.header then
                Html.th cellAttrs kids

            else
                Html.td cellAttrs kids

        Text _ ->
            Html.span (attrs node "t") (Array.flatten [ own, kids ])

        Emphasis ->
            Html.em (attrs node "") kids

        Strong ->
            Html.strong (attrs node "") kids

        Strikethrough ->
            Html.node "del" (attrs node "") kids

        CodeSpan _ ->
            Html.code (attrs node "") own

        Link link ->
            Html.a
                (Array.pushLast (Attr.href link.url) (attrs node ""))
                kids

        Image image ->
            Html.img
                (Array.flatten
                    [ attrs node ""
                    , [ Attr.src image.url, Attr.alt image.alt, Attr.title image.title ]
                    ]
                )
                []

        LineBreak ->
            -- The space this stands for is counted but not drawn, so a
            -- highlight crossing a wrap picks up again on the next line.
            Html.br [] []

        RawHtml _ ->
            Html.code (attrs node "raw-html") own


{-| Pair each rendered child with the id of the node it came from, for the two
containers that key their children. `viewChildren` walks `Doc.children` in order
and appends in that order, so the two arrays line up. Doing this here, rather
than in the walk, keeps every other element from paying for keys it never uses.
-}
keyed : Node -> Array (Html Msg) -> Array { key : String, node : Html Msg }
keyed node kids =
    Array.map2
        (\child html -> { key = Doc.id child, node = html })
        (Doc.children node)
        kids


{-| Every rendered element carries its node id, source span and source line.
The selection handler in JS reads the first two to build an anchor; the line is
drawn in the margin by CSS, which keeps it out of the DOM text the anchor is cut
from — a number rendered as an element would end up inside quoted passages.
-}
attrs : Node -> String -> Array (Html.Attribute Msg)
attrs node extraClass =
    let
        nodeSpan =
            Doc.span node

        sourceLine =
            Doc.line node
    in
    Array.flatten
        [ [ Attr.attribute "data-node-id" (Doc.id node)
          , Attr.attribute "data-span-start" (String.fromInt nodeSpan.start)
          , Attr.attribute "data-span-end" (String.fromInt nodeSpan.end)
          , Attr.class extraClass
          ]
        , if sourceLine > 0 then
            [ Attr.attribute "data-line" (String.fromInt sourceLine) ]

          else
            []
        ]


orderedAttrs : Node -> Int -> Array (Html.Attribute Msg)
orderedAttrs node start =
    if start > 0 then
        Array.pushLast (Attr.start start) (attrs node "")

    else
        attrs node ""


headingTag : Int -> Array (Html.Attribute Msg) -> Array (Html Msg) -> Html Msg
headingTag level =
    when level is
        1 ->
            Html.h1

        2 ->
            Html.h2

        3 ->
            Html.h3

        4 ->
            Html.h4

        5 ->
            Html.h5

        _ ->
            Html.h6


viewCheckbox : Bool -> Html Msg
viewCheckbox isChecked =
    Html.input
        [ Attr.type_ "checkbox"
        , Attr.checked isChecked
        , Attr.disabled True
        ]
        []


alignStyle : Align -> Html.Attribute Msg
alignStyle align =
    when align is
        AlignLeft ->
            Attr.style "text-align" "left"

        AlignRight ->
            Attr.style "text-align" "right"

        AlignCenter ->
            Attr.style "text-align" "center"

        AlignDefault ->
            Attr.style "" ""


{-| Render one leaf's text, marked where a commented passage covers it, and
report where the walk has reached.
-}
markUp : Array Range -> Int -> String -> { html : Array (Html Msg), next : Int }
markUp marks base text =
    { html = Array.map viewPiece (Marks.split marks base text)
    , next = base + String.count text
    }


viewPiece : Marks.Piece -> Html Msg
viewPiece piece =
    when piece.thread is
        Just threadId ->
            Html.node "mark"
                [ Attr.class "anchored"
                , Attr.title "Go to this thread"
                , Events.onClick (FocusThread threadId)
                ]
                [ Html.text piece.text ]

        Nothing ->
            Html.text piece.text


{-| Where each unresolved thread's quote sits in the document's text, and which
thread each one is. A resolved thread is not marked, so a highlight always leads
somewhere still open -- which is the point of following one.
-}
marksIn : Array Char -> Array Thread -> Array Range
marksIn plain threads =
    threads
        |> Array.keepIf (\thread -> thread.status /= Resolved)
        |> Array.mapAndKeepJust
            (\thread ->
                Marks.find plain thread.anchor.quote
                    |> Maybe.map
                        (\at -> { start = at.start, end = at.end, thread = thread.id })
            )
        |> Array.sortBy .start


-- SIDEBAR


viewSidebar : Model -> Html Msg
viewSidebar model =
    Html.aside
        [ Attr.class "threads", Attr.id threadsPaneId ]
        (if Array.isEmpty model.threads then
            [ Html.p
                [ Attr.class "empty" ]
                [ Html.text "Select text in the document to comment." ]
            ]

         else
            Array.map (viewThread model.replyDrafts) model.threads
        )


viewThread : Dict String String -> Thread -> Html Msg
viewThread drafts thread =
    Html.section
        [ Attr.class ("thread " ++ statusClass thread.status)
        , Attr.id (threadElementId thread.id)
        , Attr.attribute "data-thread-id" thread.id
        ]
        [ Html.blockquote [ Attr.class "quote" ] [ Html.text thread.anchor.quote ]
        , Html.div [ Attr.class "messages" ] (Array.map viewMessage thread.messages)
        , viewCommitLink thread.commit
        , viewThreadActions drafts thread
        ]


viewMessage : Protocol.Message -> Html Msg
viewMessage message =
    Html.div
        [ Attr.class
            (when message.role is
                User ->
                    "msg user"

                Assistant ->
                    "msg assistant"
            )
        ]
        [ Html.text message.text ]


viewCommitLink : String -> Html Msg
viewCommitLink commit =
    if String.isEmpty commit then
        Html.text ""

    else
        Html.div
            [ Attr.class "commit" ]
            [ Html.text ("committed " ++ String.takeFirst 8 commit) ]


viewThreadActions : Dict String String -> Thread -> Html Msg
viewThreadActions drafts thread =
    when thread.status is
        Thinking ->
            -- The dots are one string with the tail clipped by a CSS animation,
            -- rather than five elements appearing in turn: the width is then
            -- fixed and the thread does not twitch while the model thinks.
            Html.div
                [ Attr.class "pending", Attr.attribute "aria-label" "waiting for the model" ]
                [ Html.span [ Attr.class "dots" ] [ Html.text "....." ] ]

        Resolved ->
            Html.div [ Attr.class "resolved" ] [ Html.text "resolved" ]

        _ ->
            Html.div
                [ Attr.class "actions" ]
                [ Html.textarea
                    [ Attr.class "reply"
                    , Attr.placeholder "Reply…"
                    , Attr.value (Maybe.withDefault "" (Dict.get thread.id drafts))
                    , Events.onInput
                        (\text -> ReplyChanged { threadId = thread.id, text = text })
                    , composerKeys { submit = SubmitReply thread.id, cancel = Nothing }
                    ]
                    []
                , Html.button
                    [ Events.onClick (SubmitReply thread.id) ]
                    [ Html.text "Send" ]
                , Html.button
                    [ Attr.class "secondary", Events.onClick (ResolveThread thread.id) ]
                    [ Html.text "Resolve" ]
                ]


statusClass : ThreadStatus -> String
statusClass status =
    when status is
        Open ->
            "open"

        Thinking ->
            "thinking"

        Resolved ->
            "resolved"

        Outdated ->
            "outdated"


-- COMPOSER


viewComposer : Maybe Composing -> Html Msg
viewComposer composing =
    when composing is
        Nothing ->
            Html.text ""

        Just active ->
            Html.div
                [ Attr.class "composer" ]
                [ Html.blockquote
                    [ Attr.class "quote" ]
                    [ Html.text active.anchor.quote ]
                , if active.stale then
                    Html.p
                        [ Attr.class "stale" ]
                        [ Html.text "This passage has changed since you selected it." ]

                  else
                    Html.text ""
                , when active.edit is
                    Just editing ->
                        viewEditor editing

                    Nothing ->
                        viewCommentForm active
                ]


viewCommentForm : Composing -> Html Msg
viewCommentForm active =
    Html.div
        [ Attr.class "form" ]
        [ Html.textarea
            [ Attr.placeholder "reword this / why this? / …"
            , Attr.value active.draft
            , Attr.autofocus True
            , Events.onInput DraftChanged
            , composerKeys { submit = SubmitComment, cancel = Just CancelComment }
            ]
            []
        , Html.div
            [ Attr.class "composer-actions" ]
            [ Html.button
                [ Events.onClick SubmitComment
                , Attr.disabled (active.sent /= Nothing)
                ]
                [ Html.text
                    (if active.sent /= Nothing then
                        "Sending…"

                     else
                        "Comment"
                    )
                ]
            , Html.button
                [ Attr.class "secondary", Events.onClick StartEdit ]
                [ Html.text "Edit it myself" ]
            , Html.button
                [ Attr.class "secondary", Events.onClick CancelComment ]
                [ Html.text "Cancel" ]
            ]
        ]


{-| The passage as Markdown, for the reviewer to change by hand.

What is in the box is the source, not the rendered words: an asterisk the
renderer ate is still an asterisk in the file, and editing the rendered text
would quietly drop every one of them.

-}
viewEditor : Editing -> Html Msg
viewEditor editing =
    if not editing.ready then
        Html.div
            [ Attr.class "form" ]
            [ Html.p
                [ Attr.class "note" ]
                [ Html.text "Fetching the Markdown behind this passage…" ]
            , Html.div
                [ Attr.class "composer-actions" ]
                [ Html.button
                    [ Attr.class "secondary", Events.onClick CancelEdit ]
                    [ Html.text "Cancel" ]
                ]
            ]

    else
        Html.div
            [ Attr.class "form" ]
            [ Html.p
                [ Attr.class "note" ]
                [ Html.text "Markdown source. Saving commits it; no model turn runs." ]
            , Html.textarea
                [ Attr.class "source"
                , Attr.rows 5
                , Attr.spellcheck False
                , Attr.value editing.draft
                , Attr.autofocus True
                , Events.onInput EditChanged
                , composerKeys { submit = SubmitEdit, cancel = Just CancelEdit }
                ]
                []
            , Html.div
                [ Attr.class "composer-actions" ]
                [ Html.button
                    [ Events.onClick SubmitEdit, Attr.disabled editing.sent ]
                    [ Html.text
                        (if editing.sent then
                            "Saving…"

                         else
                            "Save"
                        )
                    ]
                , Html.button
                    [ Attr.class "secondary", Events.onClick CancelEdit ]
                    [ Html.text "Cancel" ]
                ]
            ]


{-| The two keys a box of typed words answers to: Shift-Enter sends it, Escape
abandons it.

Both live here rather than in the selection handler in JS, which used to catch
Escape by watching every keyup: that handler could not tell Escape from any
other key pressed with Shift, so typing a "?" into this box looked like a new
selection and threw the draft away.

Shift-Enter has to preventDefault. Without it the browser puts a newline in the
box on its way to the send, which is invisible while the box is about to close
and very visible when the server refuses the frame and the words come back with
a blank line grown on the end.

-}
composerKeys : { submit : Msg, cancel : Maybe Msg } -> Html.Attribute Msg
composerKeys keys =
    Events.preventDefaultOn "keydown"
        (Decode.map2
            (\key shift -> { key = key, shift = shift })
            (Decode.field "key" Decode.string)
            (Decode.field "shiftKey" Decode.bool)
            |> Decode.andThen (keyAction keys)
        )


keyAction :
    { submit : Msg, cancel : Maybe Msg }
    -> { key : String, shift : Bool }
    -> Decode.Decoder { message : Msg, preventDefault : Bool }
keyAction keys event =
    if event.key == "Enter" && event.shift then
        Decode.succeed { message = keys.submit, preventDefault = True }

    else
        when { key = event.key, cancel = keys.cancel } is
            { key = "Escape", cancel = Just msg } ->
                Decode.succeed { message = msg, preventDefault = False }

            _ ->
                Decode.fail "not a composer key"


-- MAIN


main : Program { theme : String } Model Msg
main =
    Browser.element
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
