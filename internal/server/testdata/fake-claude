#!/usr/bin/env python3
"""A stand-in for the claude CLI that speaks the same stream-json protocol.

It exists so the daemon's whole pipeline -- prompt in, tool_use out, edit on
disk, commit, re-render, frames to the browser -- can be tested without a model
in the loop. It reads user frames from stdin for as long as stdin stays open,
exactly as the real CLI does.

Behaviour: a comment containing "reword" rewrites the quoted passage in the
named file and reports an Edit tool call. A reviewing pass -- recognised by the
section it is handed -- answers with the fenced JSON array of proposals the
critic prompt asks for. Asked to repair a misquote, it does what a real model
would: it takes the text the daemon showed it and requotes from that. Anything
else is answered with prose and touches nothing.
"""
import json
import os
import re
import sys

SESSION = "00000000-0000-4000-8000-000000000000"


def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def parse_prompt(text):
    """Pull the file path and the first quoted block out of a prompt."""
    path = None
    match = re.search(r"^File:\s*(.+)$", text, re.M)
    if match:
        path = match.group(1).strip()

    quote = None
    # Both phrasings: a reviewer's own comment names the passage they selected,
    # and a machine thread handed to the editing conversation names the passage
    # a pass raised.
    match = re.search(
        r"(?:selected this passage|raised a comment on this passage):\n\n((?:> .*\n)+)",
        text)
    if match:
        quote = "\n".join(line[2:] for line in match.group(1).strip().split("\n"))

    return path, quote


def parse_section(text):
    """Pull the section text out of a reviewing pass's prompt."""
    match = re.search(r"as the reader sees it:\n\n((?:>.*\n)+)", text)
    if not match:
        return None
    lines = match.group(1).rstrip("\n").split("\n")
    return "\n".join(line[2:] for line in lines)


def review_reply(section):
    """Answer a reviewing pass.

    Three proposals, one of each kind the gate has to tell apart:

    - one quoting the longest line of the section, which must anchor;
    - one whose opening words are real but which then diverges, which must be
      refused and then repaired from the hint the daemon sends back;
    - one that is nowhere in the document at all, which must be refused and
      must stay refused.

    The gate is the whole point of the feature, so the stub exercises every
    side of it on every section.
    """
    lines = [line.strip() for line in section.split("\n") if line.strip()]
    quotable = max(lines, key=len)

    proposals = [
        {"quote": quotable, "comment": "The fake reviewer has doubts about this."},
        {"quote": "\u00a7\u00a7 a passage in no document anywhere \u00a7\u00a7",
         "comment": "This one cannot be anchored at all and must be dropped."},
    ]

    # A misquote of some other line, so that repairing it lands somewhere the
    # first proposal has not already claimed. Without a second long line there
    # is nowhere for it to go, and the section simply does not exercise repair.
    others = [line for line in lines if line != quotable and len(line) > 40]
    if others:
        proposals.insert(1, {
            "quote": " ".join(others[-1].split()[:4]) + " something it never said",
            "comment": "This one is misquoted and can be repaired.",
        })
    return "Here is what I found.\n\n```json\n" + json.dumps(proposals, indent=2) + "\n```\n"


def repair_reply(text):
    """Requote from what the daemon says the text actually reads.

    A real model fixes a misquote by looking at the divergence it is shown.
    This does the same thing mechanically, which is the point: if the hint is
    not enough to requote from, this stub cannot do it either and the test
    fails.
    """
    proposals = [
        {"quote": reads, "comment": "Requoted from the text you showed me."}
        for reads in re.findall(r"the text there reads: \"((?:[^\"\\\\]|\\\\.)*)\"", text)
    ]
    for i, p in enumerate(proposals):
        proposals[i]["quote"] = p["quote"].encode().decode("unicode_escape")
    return "Requoted.\n\n```json\n" + json.dumps(proposals, indent=2) + "\n```\n"


def handle(text):
    emit({"type": "system", "subtype": "init", "session_id": SESSION,
          "tools": ["Read", "Edit", "Write", "Grep", "Glob"], "mcp_servers": []})

    section = parse_section(text)
    if "These comments were dropped" in text:
        reply = repair_reply(text)
        emit({"type": "assistant", "session_id": SESSION, "message": {
            "role": "assistant", "content": [{"type": "text", "text": reply}]}})
        emit({"type": "result", "subtype": "success", "session_id": SESSION,
              "result": reply, "is_error": False, "total_cost_usd": 0.01})
        return

    if section is not None:
        reply = review_reply(section)
        emit({"type": "assistant", "session_id": SESSION, "message": {
            "role": "assistant", "content": [{"type": "text", "text": reply}]}})
        emit({"type": "result", "subtype": "success", "session_id": SESSION,
              "result": reply, "is_error": False, "total_cost_usd": 0.01})
        return

    path, quote = parse_prompt(text)
    edited = False

    if "reword" in text.lower() and path and quote:
        try:
            with open(path, "r", encoding="utf-8") as fh:
                src = fh.read()
            if quote in src:
                with open(path, "w", encoding="utf-8") as fh:
                    fh.write(src.replace(quote, "REWORDED", 1))
                edited = True
        except OSError:
            pass

    if edited:
        emit({"type": "assistant", "session_id": SESSION, "message": {
            "role": "assistant", "content": [
                {"type": "tool_use", "name": "Edit",
                 "input": {"file_path": os.path.abspath(path)}}]}})
        reply = "Reworded the passage."
    else:
        reply = "Because the original requirement said so."

    emit({"type": "assistant", "session_id": SESSION, "message": {
        "role": "assistant", "content": [{"type": "text", "text": reply}]}})

    emit({"type": "result", "subtype": "success", "session_id": SESSION,
          "result": reply, "is_error": False, "total_cost_usd": 0.01})


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            frame = json.loads(line)
        except json.JSONDecodeError:
            continue
        if frame.get("type") != "user":
            continue
        blocks = frame.get("message", {}).get("content", [])
        text = "".join(b.get("text", "") for b in blocks if b.get("type") == "text")
        handle(text)


if __name__ == "__main__":
    main()
