# Build output
/bin/
/web/dist/*
!/web/dist/.gitkeep

# Fetched dependencies. gren.json pins exact versions, so these are recoverable
# and need not be vendored.
/web/gren_packages/
/web/.gren/
/node_modules/

# devbox.lock IS committed: it is the record of which nix derivations the
# pinned versions actually resolved to.
.devbox/

# A review's state, written at the workspace root -- here, beside .git. The
# pattern is unanchored so it also catches the snapshot directory a review of a
# subdirectory outside any repository would leave.
.ai-reviewer/
